<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>IntegratedModManager.DeveloperTools</RootNamespace>
    <AssemblyName>IntegratedModManager.DeveloperTools</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnablePreviewMsixTooling>false</EnablePreviewMsixTooling>
    <ApplicationIcon>..\..\src\WinUI3\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>
  </PropertyGroup>

  <!-- The same Windows App SDK and toolkit as the app (src/WinUI3); .github/dependabot.yml keeps both on 1.7. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IntegratedModManager.Core\IntegratedModManager.Core.csproj" />
  </ItemGroup>

  <!-- The app's design tokens and shared styles, so the tools look like the app. Plain resource dictionaries:
       linking them shares no code with the app's build. -->
  <ItemGroup>
    <Page Include="..\..\src\WinUI3\Themes\Tokens.xaml" Link="Themes\Tokens.xaml" />
    <Page Include="..\..\src\WinUI3\Styles\Controls.xaml" Link="Styles\Controls.xaml" />
    <Page Include="..\..\src\WinUI3\Styles\Pages.xaml" Link="Styles\Pages.xaml" />
  </ItemGroup>

  <!-- UI text: one file per language, embedded like the app's. -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" LogicalName="DeveloperTools.Strings.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\WinUI3\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\WinUI3\Assets\AppIcon.png" Link="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
