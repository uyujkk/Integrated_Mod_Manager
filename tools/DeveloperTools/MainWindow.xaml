<Window
    x:Class="IntegratedModManager.DeveloperTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app icon and name; the window's own caption buttons sit on the right. -->
        <Grid x:Name="AppTitleBar" Height="40" Padding="16,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/AppIcon.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNav" Tag="overview"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="RepositoriesNav" Tag="repositories"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="RecordsNav" Tag="records"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="LogsNav" Tag="logs"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="CachesNav" Tag="caches"><NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="ModKeysNav" Tag="modkeys"><NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="TranslationsNav" Tag="translations"><NavigationViewItem.Icon><FontIcon Glyph="&#xF2B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="FilesNav" Tag="files"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="DiagnosticsNav" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <!-- The tools' own choices: language and theme. -->
            <NavigationView.PaneFooter>
                <StackPanel Spacing="8" Padding="12,8,12,12">
                    <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged" />
                    <ComboBox x:Name="ThemeComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid Padding="24,8,24,24" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The app folder being inspected, and the tools' own choices. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RootLabel" VerticalAlignment="Center" />
                        <TextBox x:Name="RootPathTextBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" />
                        <Button x:Name="BrowseRootButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseRootClicked" />
                        <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Click="OnRefreshClicked" />
                        <ToggleSwitch x:Name="AutoRefreshToggle" Grid.Column="4" MinWidth="0" VerticalAlignment="Center" Toggled="OnAutoRefreshToggled" />
                    </Grid>
                </Border>

                <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

                <Grid x:Name="PageHost" Grid.Row="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
