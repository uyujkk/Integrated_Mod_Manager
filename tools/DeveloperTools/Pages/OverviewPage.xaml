<UserControl
    x:Class="IntegratedModManager.DeveloperTools.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="12" Padding="0,0,8,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource ToolPageTitleStyle}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
            <InfoBar x:Name="RunningInfoBar" IsClosable="False" Severity="Informational" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="VersionValue" Style="{StaticResource SectionTitleTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RepositoriesLabel" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="RepositoriesValue" Style="{StaticResource SectionTitleTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="StorageLabel" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="StorageValue" Style="{StaticResource SectionTitleTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="FilesLabel" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="FilesValue" Style="{StaticResource SectionTitleTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="RuntimeTitle" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBox x:Name="RuntimeTextBox" Style="{StaticResource ToolMonoTextBoxStyle}" MinHeight="220" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="BreakdownTitle" Style="{StaticResource CardTitleTextStyle}" />
                        <StackPanel x:Name="BreakdownPanel" Spacing="6" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
