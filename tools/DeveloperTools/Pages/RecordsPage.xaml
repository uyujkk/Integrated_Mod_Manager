<UserControl
    x:Class="IntegratedModManager.DeveloperTools.Pages.RecordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource ToolPageTitleStyle}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="RecordsLabel" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock x:Name="RecordsValue" Style="{StaticResource SectionTitleTextStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SlotsLabel" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock x:Name="SlotsValue" Style="{StaticResource SectionTitleTextStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LinksLabel" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock x:Name="LinksValue" Style="{StaticResource SectionTitleTextStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="FindingsLabel" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock x:Name="FindingsValue" Style="{StaticResource SectionTitleTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ListTitle" Style="{StaticResource CardTitleTextStyle}" />
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="FindingsPanel" Spacing="6" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
