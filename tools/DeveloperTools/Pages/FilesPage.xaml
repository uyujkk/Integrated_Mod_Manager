<UserControl
    x:Class="IntegratedModManager.DeveloperTools.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource ToolPageTitleStyle}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                <ListView x:Name="FileListView" SelectionChanged="OnFileSelected" />
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox" TextChanged="OnSearchChanged" />
                        <Button x:Name="ValidateButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="OnValidateClicked" />
                        <Button x:Name="CopyButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="OnCopyClicked" />
                        <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Click="OnSaveClicked" />
                    </Grid>
                    <TextBox x:Name="ViewerTextBox" Grid.Row="1" Style="{StaticResource ToolMonoTextBoxStyle}" />
                    <TextBlock x:Name="ViewerStatus" Grid.Row="2" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
