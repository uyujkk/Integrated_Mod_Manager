<UserControl
    x:Class="IntegratedModManager.DeveloperTools.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Spacing="12" Padding="0,0,8,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource ToolPageTitleStyle}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
            <toolkit:SettingsCard x:Name="ExportCard">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="ExportButton" Style="{StaticResource PrimaryButtonStyle}" Click="OnExportClicked" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="SnapshotCard">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C8;" /></toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="SnapshotButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnSnapshotClicked" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="FoldersCard">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE838;" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenDiagnosticsButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenDiagnosticsClicked" />
                    <Button x:Name="OpenSnapshotsButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenSnapshotsClicked" />
                </StackPanel>
            </toolkit:SettingsCard>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PreviewTitle" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBox x:Name="PreviewTextBox" Style="{StaticResource ToolMonoTextBoxStyle}" MinHeight="260" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
