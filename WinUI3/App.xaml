<Application
    x:Class="ModFolderCopier.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#F3F6FB" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#D7DFEA" />
                    <SolidColorBrush x:Key="AppInsetBackgroundBrush" Color="#EEF3F9" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E7F0FF" />
                    <SolidColorBrush x:Key="AppNavSelectedBrush" Color="#DCEBFF" />
                    <SolidColorBrush x:Key="AppNavSelectedForegroundBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="AppNavDefaultForegroundBrush" Color="#1F2937" />
                    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="#94A0AF" />
                    <SolidColorBrush x:Key="AppSecondaryDefaultBrush" Color="#F7FAFD" />
                    <SolidColorBrush x:Key="AppSecondaryDefaultForegroundBrush" Color="#1F2937" />
                    <SolidColorBrush x:Key="AppSecondarySelectedBrush" Color="#E1EEFF" />
                    <SolidColorBrush x:Key="AppSecondarySelectedForegroundBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="#EAF0F7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#11161D" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#1A212B" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#2D3643" />
                    <SolidColorBrush x:Key="AppInsetBackgroundBrush" Color="#202833" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#18314B" />
                    <SolidColorBrush x:Key="AppNavSelectedBrush" Color="#24466E" />
                    <SolidColorBrush x:Key="AppNavSelectedForegroundBrush" Color="#F8FBFF" />
                    <SolidColorBrush x:Key="AppNavDefaultForegroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="#7D8794" />
                    <SolidColorBrush x:Key="AppSecondaryDefaultBrush" Color="#242D39" />
                    <SolidColorBrush x:Key="AppSecondaryDefaultForegroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppSecondarySelectedBrush" Color="#2A4E78" />
                    <SolidColorBrush x:Key="AppSecondarySelectedForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="#141B23" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="InsetBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppInsetBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="SoftBadgeBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppAccentSoftBrush}" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.74" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="BorderBrush" Value="#2563EB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="MinHeight" Value="40" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppInsetBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinHeight" Value="40" />
            </Style>

            <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="AppListViewStyle" TargetType="ListView">
                <Setter Property="Padding" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="IsItemClickEnabled" Value="False" />
            </Style>

            <Style x:Key="ShortcutInputTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
