<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The updater the app copies to a temporary file and runs. One framework-dependent file on the same
    .NET 8 runtime the app needs; before 4.7.1 it was a .NET Framework program compiled with csc.exe,
    which several machine-learning scanners flagged (GameBanana withheld the 4.7.0 upload for it).
    Built by scripts\test-all.ps1 and scripts\build_winui.bat with dotnet publish; tests compile the
    same source through src\IntegratedModManager.UpdateAgent.Core.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <AssemblyName>LocalUpdateAgent</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>..\WinUI3\Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>LocalUpdateAgent.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LocalUpdateAgent.cs" />
  </ItemGroup>
</Project>
