<UserControl
    x:Class="ModFolderCopier.WinUI.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- Stage J4 (docs/development/UI-Fluent-Design-Plan.md, "仪表盘（J4）"): the current repository in one card
         with its main actions, a warning when the Mod folder is missing, the quick actions as clickable cards,
         the paths folded into one expander, then the characters and every repository. The page shows
         DashboardViewModel and RepositoryPathsViewModel and sends clicks to the window through them. -->
    <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="DashboardRootPanel" Margin="2,2,8,20" Spacing="12">
            <local:PageHeader x:Name="DashboardPageHeader">
                <local:PageHeader.Actions>
                    <!-- New repository: blank, or from a game preset. -->
                    <DropDownButton x:Name="AddRepositoryButton" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Name="DashboardAddRepositoryTextBlock" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="NewRepositoryMenu" Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </local:PageHeader.Actions>
            </local:PageHeader>

            <!-- A repository without its Mod folder can do nothing yet: say so above everything else. -->
            <InfoBar x:Name="DashboardPathsInfoBar" Severity="Warning" IsClosable="False" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="DashboardSetPathsButton" Click="OnSetPathsClicked" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The current repository: name with a switcher, status and counts, and its main actions. -->
            <Border x:Name="DashboardRepositorySelectorCard" Style="{StaticResource CardBorderStyle}" Padding="20,16">
                <Grid x:Name="DashboardStripGrid" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="56" Height="56" CornerRadius="12" Background="{ThemeResource AppSecondarySelectedBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="26" Foreground="{ThemeResource AppSecondarySelectedForegroundBrush}" />
                    </Border>
                    <StackPanel x:Name="DashboardStripStatus" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="DashboardCurrentRepositoryLabelTextBlock" Style="{StaticResource CaptionTextStyle}" />
                        <!-- The name is the switcher: it lists every repository. -->
                        <DropDownButton x:Name="DashboardRepositorySwitcher" Padding="0,0,8,0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left">
                            <TextBlock x:Name="DashboardCurrentRepositoryNameTextBlock" Style="{StaticResource SectionTitleTextStyle}" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="DashboardRepositoryMenu" Placement="BottomEdgeAlignedLeft" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid VerticalAlignment="Center">
                                <Border Style="{StaticResource StatusBadgeSuccessBorderStyle}" Visibility="{x:Bind ViewModel.CurrentIsReady, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentStatusText, Mode=OneWay}" Style="{StaticResource StatusBadgeSuccessTextStyle}" FontWeight="SemiBold" />
                                </Border>
                                <Border Style="{StaticResource StatusBadgeDangerBorderStyle}" Visibility="{x:Bind ViewModel.CurrentNeedsSetup, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentStatusText, Mode=OneWay}" Style="{StaticResource StatusBadgeDangerTextStyle}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CurrentSummary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="DashboardStripActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="RenameRepositoryButton" Click="OnEditRepositoryDetailsClicked" Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanEditRepository, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock x:Name="DashboardEditRepositoryTextBlock" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DashboardOpenRepositoryButton" Click="OnDashboardOpenRepositoryClicked" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanOpenRepository, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick actions: a row of clickable cards on wide pages, a column on narrow ones. -->
            <TextBlock x:Name="DashboardQuickActionsTitleTextBlock" Style="{StaticResource CardTitleTextStyle}" Margin="1,8,0,0" />
            <Grid x:Name="DashboardQuickActionsGrid" ColumnSpacing="8" RowSpacing="4">
                <toolkit:SettingsCard x:Name="DashboardBrowseOnlineButton" IsClickEnabled="True" Click="OnDashboardBrowseOnlineClicked">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="DashboardCheckUpdatesButton" IsClickEnabled="True" Click="OnDashboardCheckUpdatesClicked">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="DashboardRunLauncherButton" IsClickEnabled="True" Click="OnRunLauncherClicked"
                                      IsEnabled="{x:Bind Paths.CanRunLauncher, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE768;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </Grid>

            <!-- Paths: settings, so folded by default; it opens by itself while a required path is missing. -->
            <toolkit:SettingsExpander x:Name="DashboardPathsExpander">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="DashboardPathsSummaryTextBlock" VerticalAlignment="Center" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard x:Name="SourcePathCard" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon x:Name="SourceStatusIcon" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceTextBox" Text="{x:Bind Paths.Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Paths.ArePathsEditable, Mode=OneWay}" />
                            <Button x:Name="PickSourceButton" Grid.Column="1" Click="OnPickSourceClicked" />
                            <Button x:Name="OpenSourceButton" Grid.Column="2" Click="OnOpenSourceClicked" />
                        </Grid>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="TargetPathCard" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon x:Name="TargetStatusIcon" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetTextBox" Text="{x:Bind Paths.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Paths.ArePathsEditable, Mode=OneWay}" />
                            <Button x:Name="PickTargetButton" Grid.Column="1" Click="OnPickTargetClicked" />
                            <Button x:Name="OpenTargetButton" Grid.Column="2" Click="OnOpenTargetClicked" />
                        </Grid>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="LauncherPathCard" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon x:Name="LauncherStatusIcon" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LauncherTextBox" Text="{x:Bind Paths.Launcher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Paths.ArePathsEditable, Mode=OneWay}" />
                            <Button x:Name="PickLauncherButton" Grid.Column="1" Click="OnPickLauncherClicked" />
                            <Button x:Name="OpenLauncherButton" Grid.Column="2" Click="OnOpenLauncherClicked" />
                        </Grid>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="BridgeOptionsButton" IsClickEnabled="True" Click="OnBridgeOptionsClicked"
                                          Visibility="{x:Bind ViewModel.BridgeVisible, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.BridgeEnabled, Mode=OneWay}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7FC;" />
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="LinkDeploymentSettingsCard">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE71B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="LinkDeploymentToggleSwitch"
                            IsOn="{x:Bind Paths.UseDirectoryLinks, Mode=TwoWay}"
                            IsEnabled="{x:Bind Paths.IsLinkDeploymentEditable, Mode=OneWay}" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <!-- Characters beside every repository on wide pages, stacked on narrow ones. -->
            <Grid x:Name="DashboardMainGrid" ColumnSpacing="12" RowSpacing="12">
                <Border x:Name="DashboardCharactersCard" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DashboardCharactersTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="DashboardCharactersHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind ViewModel.CharactersEmptyText, Mode=OneWay}"
                            Style="{StaticResource MutedTextStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasCharactersEmptyText, Mode=OneWay}" />
                        <GridView
                            x:Name="DashboardCharactersGridView"
                            Grid.Row="1"
                            Visibility="{x:Bind ViewModel.HasCharacters, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="OnDashboardCharacterClicked"
                            ItemsSource="{x:Bind ViewModel.Characters}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="60" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:CharacterChipViewModel">
                                    <Grid Width="186" Height="52" Padding="8,6" ColumnSpacing="10" CornerRadius="10" Background="{ThemeResource AppInsetBackgroundBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AppSecondarySelectedBrush}" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{x:Bind Initial}" Foreground="{ThemeResource AppSecondarySelectedForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse Width="36" Height="36" Visibility="{x:Bind HasAvatar, Mode=OneWay}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Border>
                <Border x:Name="DashboardRepositoriesCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DashboardRepositoriesTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="DashboardRepositoriesHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsRepeater x:Name="DashboardRepositoriesRepeater" ItemsSource="{x:Bind ViewModel.Repositories}">
                            <ItemsRepeater.Layout>
                                <!-- UniformGridLayout divides by zero when measured narrower than one item while the page re-lays out. -->
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:RepositoryCardViewModel">
                                    <Grid>
                                        <Border Style="{StaticResource InsetBorderStyle}" Padding="14,12">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Grid Grid.Column="1" VerticalAlignment="Top">
                                                        <Border Style="{StaticResource StatusBadgeSuccessBorderStyle}" Visibility="{x:Bind IsReady, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource StatusBadgeSuccessTextStyle}" />
                                                        </Border>
                                                        <Border Style="{StaticResource StatusBadgeDangerBorderStyle}" Visibility="{x:Bind NeedsSetup, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource StatusBadgeDangerTextStyle}" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                                <Grid Grid.Row="2" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        Command="{x:Bind SwitchToCommand}"
                                                        Content="{x:Bind Labels.SwitchTo, Mode=OneWay}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Visibility="{x:Bind IsOther, Mode=OneWay}" />
                                                    <TextBlock
                                                        Text="{x:Bind Labels.Current, Mode=OneWay}"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource AppAccentBrush}"
                                                        FontWeight="SemiBold"
                                                        Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                                    <Button Grid.Column="1" Command="{x:Bind ManageCommand}" Content="{x:Bind Labels.Manage, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Width="40"
                                                        Padding="0"
                                                        AutomationProperties.Name="{x:Bind Labels.More, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind Labels.More, Mode=OneWay}"
                                                        Style="{StaticResource SecondaryButtonStyle}">
                                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuFlyoutItem Text="{x:Bind Labels.Edit, Mode=OneWay}" Command="{x:Bind EditCommand}">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="{x:Bind Labels.OpenWiki, Mode=OneWay}" Command="{x:Bind OpenWikiCommand}">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem Text="{x:Bind Labels.Delete, Mode=OneWay}" Command="{x:Bind DeleteCommand}">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <!-- The current repository is outlined in the accent colour. -->
                                        <Border
                                            BorderBrush="{ThemeResource AppNavSelectedBorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
