<UserControl
    x:Class="ModFolderCopier.WinUI.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- The Mod workspace page (stage J7): moved from MainWindow.xaml as it was, with the styles only it uses. -->
    <UserControl.Resources>
        <!-- Styles only this window's pages use (moved from App.xaml in stage J8). -->
        <Style x:Key="CommandSurfaceBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppCommandSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="AppListViewStyle" TargetType="ListView">
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="IsItemClickEnabled" Value="False" />
        </Style>

        <Style x:Key="AppListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>

        <!-- Narrow side lists (the workspace's characters): less item padding, so names keep more room. -->
        <Style x:Key="CompactListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource AppListViewItemStyle}">
            <Setter Property="Padding" Value="6,0,6,0" />
        </Style>

        <DataTemplate x:Key="RepositoryCoverTemplate" x:DataType="local:SecondLevelFolderItem">
            <Button Click="OnRepositoryCoverClicked" DoubleTapped="OnSecondLevelDoubleTapped"
                    RightTapped="OnSecondLevelItemRightTapped" Padding="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind Name}"
                    BorderThickness="{x:Bind CoverSelectionThickness, Mode=OneWay}"
                    BorderBrush="{ThemeResource AppNavSelectedBorderBrush}"
                    Background="{ThemeResource AppCardBackgroundBrush}">
            <Grid Margin="4" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource AppCardBorderBrush}"
                  Background="{ThemeResource AppCardBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{x:Bind CoverPreviewHeight, Mode=OneWay}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Background="{ThemeResource AppPreviewBackgroundBrush}" CornerRadius="4">
                    <Image Source="{x:Bind CoverImageSource, Mode=OneWay}" Stretch="Uniform" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9"
                                Visibility="{x:Bind CoverPlaceholderVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xEB9F;" FontSize="28" Opacity="0.75" />
                        <TextBlock Text="{x:Bind CoverPlaceholder, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Padding="10" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" MaxLines="2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="1" ColumnSpacing="7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Center" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="{x:Bind State, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
            <Grid x:Name="WorkspacePageHost" x:FieldModifier="internal" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Title and repository picker with the command bar (refresh, import, launch); under them the view buttons and the counts. -->
                <Border x:Name="RepositoryToolbarCard" Style="{StaticResource CommandSurfaceBorderStyle}" Padding="14,10,14,10" CornerRadius="6">
                    <Grid x:Name="RepositoryToolbarGrid" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="RepositoryHeaderGrid" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock x:Name="WorkspaceTitleTextBlock" Style="{StaticResource PageTitleTextStyle}" />
                                <ComboBox x:Name="RepositoryWorkspacePicker" MinWidth="190" MaxWidth="300" MinHeight="32" HorizontalAlignment="Left"
                                        SelectionChanged="OnRepositoryWorkspacePickerSelectionChanged" />
                            </StackPanel>
                            <!-- Stage J7-b: the page commands as a command bar; labels go when the window is narrow, the
                                 automation ids stay the old button names. -->
                            <CommandBar x:Name="RepositoryCommandBar" Grid.Column="1" DefaultLabelPosition="Right" IsOpen="False"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" OverflowButtonVisibility="Collapsed" Background="Transparent">
                                <AppBarButton x:Name="RefreshButton" x:FieldModifier="internal" Click="OnRefreshClicked">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="ImportZipButton" x:FieldModifier="internal" Click="OnImportZipClicked">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="RunLauncherButton" x:FieldModifier="internal" Click="OnRunLauncherClicked">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- The view buttons, details and the import commands are added by RepositoryWorkspace.cs and ExistingModImport.cs.
                                 The buttons keep their width; the counts give way and trim when a language needs more room. -->
                            <StackPanel x:Name="RepositoryViewButtonsPanel" Orientation="Horizontal" Spacing="6" />
                            <TextBlock x:Name="RepositoryCountTextBlock" Grid.Column="1" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </Grid>
                </Border>
                <!-- Hidden holders: the toolbar and footer take these controls, and the counts are read from the metrics. -->
                <Grid x:Name="WorkspaceActionsGrid" ColumnSpacing="14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <ProgressBar x:Name="CopyProgressBar" Minimum="0" Maximum="100" Height="8" />
                        <TextBlock x:Name="ProgressTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="RepositoryMetricsGrid" Visibility="Collapsed" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" MinWidth="220" />
                        <ColumnDefinition Width="1.1*" MinWidth="220" />
                        <ColumnDefinition Width="1.15*" MinWidth="240" />
                        <ColumnDefinition Width="1.05*" MinWidth="220" />
                    </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FirstCountLabelTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="FirstCountTextBlock" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                    <TextBlock x:Name="FirstCountHintTextBlock" x:FieldModifier="internal" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SecondCountLabelTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="SecondCountTextBlock" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                    <TextBlock x:Name="SecondCountHintTextBlock" x:FieldModifier="internal" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CurrentStateLabelTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="CurrentStateHintTextBlock" x:FieldModifier="internal" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CurrentFolderLabelTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="CurrentFolderHintTextBlock" x:FieldModifier="internal" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
                <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Row="1"
                        VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid x:Name="WorkspaceContentGrid" RowSpacing="10" Margin="0,0,8,4" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="WorkspaceWorkbench" ColumnSpacing="12" RowSpacing="12">
                            <!-- Characters: heading with add and "More", search, the list, and a hint while the repository is empty. -->
                            <Border x:Name="CategoryCard" Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RepositoryCategoryTitleTextBlock" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button x:Name="CreateFirstLevelButton" x:FieldModifier="internal" Grid.Column="1" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="5" CornerRadius="4"
                                                Click="OnCreateFirstLevelClicked" Style="{StaticResource SecondaryButtonStyle}">
                                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                                        </Button>
                                        <!-- Rename, avatar and the several-Mods toggle are in the "More" menu, the same menu as a right-click on a
                                             character. The hidden controls keep their state and handlers. -->
                                        <Button x:Name="CharacterMoreButton" Grid.Column="2" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="5" CornerRadius="4"
                                                Click="OnCharacterMoreClicked" Style="{StaticResource SecondaryButtonStyle}">
                                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                                        </Button>
                                        <Button x:Name="RenameFirstLevelButton" x:FieldModifier="internal" Grid.Column="2" Visibility="Collapsed" Click="OnRenameFirstLevelClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="CharacterAvatarButton" Grid.Column="2" Visibility="Collapsed" Click="OnCharacterAvatarButtonClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        <ToggleButton x:Name="CharacterMultipleModsToggle" Grid.Column="2" Visibility="Collapsed" Click="OnCharacterMultipleModsToggleClicked" />
                                    </Grid>
                                    <TextBox x:Name="FirstLevelSearchTextBox" x:FieldModifier="internal" Grid.Row="1" Height="34" MinWidth="0" Padding="8,6,8,6" BorderThickness="0"
                                            TextChanged="OnFirstLevelSearchTextChanged" />
                                    <ListView x:Name="FirstLevelListView" x:FieldModifier="internal" Grid.Row="2" MinHeight="0" SingleSelectionFollowsFocus="False" SelectionChanged="OnFirstLevelSelectionChanged" Style="{StaticResource AppListViewStyle}" ItemContainerStyle="{StaticResource CompactListViewItemStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:FirstLevelFolderItem">
                                                <Grid Padding="4,8" ColumnSpacing="8" RightTapped="OnFirstLevelItemRightTapped">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="28" Height="28">
                                                        <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind AvatarInitial}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" Visibility="{x:Bind AvatarPlaceholderVisibility, Mode=OneWay}" />
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{x:Bind AvatarImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" FontSize="12" Text="{x:Bind ChildrenCount}" VerticalAlignment="Center" Opacity="0.75" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="CharacterFolderHintTextBlock" Grid.Row="3" Margin="2,8,2,0" FontSize="12" Opacity="0.75"
                                            TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <!-- Mods: heading, search and tag buttons (added by LocalTags), state chips, and the list or cover views. -->
                            <Border x:Name="ModCard" Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid x:Name="ModCardGrid" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RepositoryModTitleTextBlock" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RepositoryModCountTextBlock" Grid.Column="1" FontSize="12" VerticalAlignment="Center" />
                                        <Button x:Name="DeleteSecondLevelButton" x:FieldModifier="internal" Grid.Column="2" Width="32" Height="32" MinHeight="32" Padding="6" CornerRadius="4"
                                                Click="OnDeleteSecondLevelClicked" Style="{StaticResource SecondaryButtonStyle}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="RepositoryStateChipsPanel" Grid.Row="2" Orientation="Horizontal" Spacing="6" />
                                    <Border x:Name="SecondLevelDropBorder" Grid.Row="3" Padding="0" AllowDrop="True" Style="{StaticResource InsetBorderStyle}"
                                            DragOver="OnSecondLevelDragOver" DragLeave="OnDropTargetDragLeave" Drop="OnSecondLevelDrop">
                                        <!-- The list; RepositoryWorkspace.cs adds the cover view and the empty state over it. -->
                                        <Grid x:Name="RepositoryModViewsGrid">
                                            <ListView x:Name="SecondLevelListView" x:FieldModifier="internal" MinHeight="0" SingleSelectionFollowsFocus="False" SelectionChanged="OnSecondLevelSelectionChanged" DoubleTapped="OnSecondLevelDoubleTapped" Style="{StaticResource AppListViewStyle}" ItemContainerStyle="{StaticResource AppListViewItemStyle}">
                                                <ListView.ItemTemplate>
                                                    <!-- A row: cover thumbnail, name with its tag chips and shortcut count, size, and the state as a pill. -->
                                                    <DataTemplate x:DataType="local:SecondLevelFolderItem">
                                                        <Grid Padding="6,6" ColumnSpacing="10" RightTapped="OnSecondLevelItemRightTapped">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="40" Height="40" CornerRadius="6" Background="{ThemeResource AppPreviewBackgroundBrush}">
                                                                <FontIcon Glyph="&#xE8A5;" FontSize="16" Opacity="0.6" Visibility="{x:Bind CoverPlaceholderVisibility, Mode=OneWay}" />
                                                                <Image Source="{x:Bind CoverImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                                <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind DetailLineVisibility, Mode=OneWay}">
                                                                    <ItemsRepeater ItemsSource="{x:Bind Tags, Mode=OneWay}">
                                                                        <ItemsRepeater.Layout>
                                                                            <StackLayout Orientation="Horizontal" Spacing="4" />
                                                                        </ItemsRepeater.Layout>
                                                                        <ItemsRepeater.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Border Padding="6,0,6,1" CornerRadius="4" Background="{ThemeResource AppSecondaryDefaultBrush}">
                                                                                    <TextBlock FontSize="12" Opacity="0.85" Text="{x:Bind}" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsRepeater.ItemTemplate>
                                                                    </ItemsRepeater>
                                                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind KeysText, Mode=OneWay}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                MinWidth="64"
                                                                Style="{StaticResource CaptionTextStyle}"
                                                                Text="{x:Bind SizeText, Mode=OneWay}"
                                                                TextAlignment="Right"
                                                                VerticalAlignment="Center" />
                                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                                <Border Style="{StaticResource StatusBadgeSuccessBorderStyle}" Visibility="{x:Bind DeployedPillVisibility, Mode=OneWay}">
                                                                    <TextBlock Style="{StaticResource StatusBadgeSuccessTextStyle}" Text="{x:Bind State, Mode=OneWay}" />
                                                                </Border>
                                                                <Border Style="{StaticResource StatusBadgeBorderStyle}" Visibility="{x:Bind IdlePillVisibility, Mode=OneWay}">
                                                                    <TextBlock Style="{StaticResource StatusBadgeTextStyle}" Text="{x:Bind State, Mode=OneWay}" />
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid x:Name="WorkspaceDetailHost" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="SelectionSummaryCard" Style="{StaticResource CardBorderStyle}" CornerRadius="6" Padding="12">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Name="SelectionEyebrowTextBlock" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock x:Name="CurrentFolderTextBlock" FontSize="18" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="DeploymentStateLabelTextBlock" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="CurrentStateTextBlock" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TabView x:Name="WorkspaceDetailTabs" Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" TabWidthMode="Equal"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectedIndex="0">
                                    <TabViewItem x:Name="PreviewTab" IsClosable="False">
                                        <Border x:Name="PreviewCard" Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="PreviewSectionTitleTextBlock" x:FieldModifier="internal" Style="{StaticResource SectionTitleTextStyle}" />
                                                <TextBlock x:Name="PreviewSectionSubtitleTextBlock" x:FieldModifier="internal" Grid.Row="1" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                                <Border
                                                    x:Name="PreviewDropBorder"
                                                    Grid.Row="2"
                                                    Height="320"
                                                    AllowDrop="True"
                                                    Style="{StaticResource InsetBorderStyle}"
                                                    Background="{ThemeResource AppPreviewBackgroundBrush}"
                                                    DragOver="OnPreviewDragOver"
                                                    DragLeave="OnDropTargetDragLeave"
                                                    Drop="OnPreviewDrop">
                                                    <Grid>
                                                        <Image x:Name="PreviewImage" x:FieldModifier="internal" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ImageOpened="OnPreviewImageOpened" Tapped="OnPreviewImageTapped" />
                                                        <TextBlock
                                                            x:Name="PreviewHintTextBlock"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="18"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap"
                                                            Style="{StaticResource MutedTextStyle}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Row="3" Spacing="6">
                                                    <TextBlock x:Name="ModLinkSectionTitleTextBlock" x:FieldModifier="internal" Style="{StaticResource SectionTitleTextStyle}" />
                                                    <TextBlock x:Name="ModLinkSectionSubtitleTextBlock" x:FieldModifier="internal" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Border Grid.Row="4" Style="{StaticResource InsetBorderStyle}">
                                                    <TextBox
                                                        x:Name="ModLinkTextBox" x:FieldModifier="internal"
                                                        Padding="12,8"
                                                        BorderThickness="0"
                                                        TextChanged="OnModLinkTextChanged" />
                                                </Border>

                                                <Grid Grid.Row="5" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="PreviewFooterTextBlock" x:FieldModifier="internal" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                                    <Button
                                                        x:Name="OpenModLinkButton" x:FieldModifier="internal"
                                                        Grid.Column="1"
                                                        Click="OnOpenModLinkClicked"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </TabViewItem>
                                    <TabViewItem x:Name="ShortcutTab" IsClosable="False">
                                        <Border x:Name="ShortcutCard" Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="ShortcutSectionTitleTextBlock" x:FieldModifier="internal" Style="{StaticResource SectionTitleTextStyle}" />
                                                <Grid Grid.Row="1" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock x:Name="ShortcutSectionSubtitleTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="ShortcutRowsTextBlock" Style="{StaticResource MutedTextStyle}" />
                                                    </StackPanel>
                                                    <Button x:Name="AddShortcutRowButton" x:FieldModifier="internal" Grid.Column="1" Click="OnAddShortcutRowClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                                </Grid>
                                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="ShortcutRowsPanel" x:FieldModifier="internal" Spacing="10" />
                                                </ScrollViewer>
                                                <TextBlock
                                                    x:Name="ShortcutHintTextBlock" x:FieldModifier="internal"
                                                    Grid.Row="3"
                                                    Margin="0,4,0,2"
                                                    Style="{StaticResource MutedTextStyle}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </Border>
                                    </TabViewItem>
                                    <TabViewItem x:Name="PersistentSlotsTab" IsClosable="False">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                            <Border x:Name="PersistentSlotsCard" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="PersistentSlotTitleTextBlock" x:FieldModifier="internal" Style="{StaticResource SectionTitleTextStyle}" />
                                                    <TextBlock x:Name="PersistentSlotHintTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="PersistentUserIniTextBox" x:FieldModifier="internal" PlaceholderText="d3dx_user.ini" />
                                                        <Button x:Name="BrowsePersistentUserIniButton" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                    <ComboBox x:Name="PersistentSlotComboBox" x:FieldModifier="internal" HorizontalAlignment="Stretch" />
                                                    <ContentControl x:Name="PersistentSlotPreviewHost" x:FieldModifier="internal" HorizontalContentAlignment="Stretch" />
                                                    <TextBlock x:Name="PersistentSlotValuesTextBlock" x:FieldModifier="internal" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="CapturePersistentSlotButton" x:FieldModifier="internal" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                                                        <Button x:Name="DeletePersistentSlotButton" x:FieldModifier="internal" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                    <Button x:Name="RestorePersistentRuntimeButton" x:FieldModifier="internal" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButtonStyle}" />
                                                    <DropDownButton x:Name="PersistentSlotMoreButton" x:FieldModifier="internal" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                    <Button x:Name="OpenCombinationPresetsButton" x:FieldModifier="internal" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <TextBlock x:Name="PersistentSlotStatusTextBlock" x:FieldModifier="internal" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabViewItem>
                                </TabView>
                                <Border x:Name="RepositoryDetailFooterCard" Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="6">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="RepositoryDeploymentHintTextBlock" FontSize="12" Opacity="0.8" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Grid Grid.Row="1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="RepositoryOpenModFolderButton" MinWidth="44" MinHeight="40" CornerRadius="4"
                                                    Click="OnRepositoryOpenModFolderClicked" Style="{StaticResource SecondaryButtonStyle}">
                                                <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                            </Button>
                                            <Button x:Name="ToggleCopyButton" Grid.Column="1" MinHeight="40" HorizontalAlignment="Stretch" Click="OnToggleCopyClicked" Style="{StaticResource PrimaryButtonStyle}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <Border x:Name="WorkspaceStatusCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="AuthorTextBlock" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

        <!-- The combination preset controls. They used to sit on the Updates page; the Mod workspace's
             Presets view takes them at startup (WorkspacePage.RepositoryWorkspace.cs), so this holder
             never shows. They move with the workspace in stage J7. -->
        <Grid x:Name="CombinationProfileControlsHost" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ConfigurationProfilesTitleTextBlock" x:FieldModifier="internal" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="ConfigurationProfilesHintTextBlock" x:FieldModifier="internal" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="ConfigurationProfileComboBox" x:FieldModifier="internal"
                        MinHeight="42" />
                    <CheckBox x:Name="CaptureCombinationStateCheckBox" x:FieldModifier="internal" IsChecked="True" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CombinationUserIniTextBox" x:FieldModifier="internal" IsReadOnly="True" MinWidth="0" />
                        <Button x:Name="BrowseCombinationUserIniButton" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CreateConfigurationProfileButton" x:FieldModifier="internal" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="UpdateConfigurationProfileButton" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="ApplyConfigurationProfileButton" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="DeleteConfigurationProfileButton" x:FieldModifier="internal" Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <TextBlock x:Name="ConfigurationProfileSummaryTextBlock" x:FieldModifier="internal" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
