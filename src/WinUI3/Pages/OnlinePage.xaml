<UserControl
    x:Class="ModFolderCopier.WinUI.OnlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- The Online page (stage J6, moved from MainWindow.xaml). Stage J6-b (UI-Fluent-Design-Plan.md, "在线（J6）"):
         the header and toolbar re-flow instead of clipping (OnlineLayoutPolicy decides when). -->
    <UserControl.Resources>
        <!-- The details drawer (stage J6-b, option A): in-app acrylic over the cards, lifted by the system shadow. -->
        <Style x:Key="DetailPaneBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="StickyActionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="OnlineScrollViewer" Margin="6">
        <!-- One card: header row, then character rail beside the results. Details open in a
             drawer floating over the right side, so the page never shrinks while it is open. -->
        <Grid x:Name="OnlineDetailsHost" SizeChanged="OnOnlineDetailsHostSizeChanged">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16,12,16,12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Title, then the status (it takes what is left and trims, with the full text as a tooltip),
                             then the view switch and refresh, whose label drops when the status would get too little room. -->
                        <Grid x:Name="OnlineHeaderGrid" ColumnSpacing="10" SizeChanged="OnOnlineHeaderSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="OnlineTitlePanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="OnlineTitleTextBlock" x:FieldModifier="internal" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <!-- The page descriptions live in this tooltip instead of two header lines. -->
                                <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.7" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip MaxWidth="420">
                                            <StackPanel Spacing="6">
                                                <TextBlock x:Name="OnlinePreviewTitleTextBlock" x:FieldModifier="internal" FontWeight="SemiBold" />
                                                <TextBlock x:Name="OnlinePreviewHintTextBlock" x:FieldModifier="internal" TextWrapping="Wrap" />
                                                <TextBlock x:Name="OnlineSubtitleTextBlock" x:FieldModifier="internal" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </FontIcon>
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="OnlineCacheStatusBorder"
                                    Background="{ThemeResource AppInsetBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="OnlineCacheStatusTextBlock"
                                        MaxLines="1"
                                        Style="{StaticResource CaptionTextStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </Border>
                                <Border
                                    x:Name="OnlineStatusBorder"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AppAccentSoftBrush}"
                                    CornerRadius="6"
                                    Padding="10,4">
                                    <TextBlock
                                        x:Name="OnlineStatusTextBlock"
                                        MaxLines="1"
                                        Style="{StaticResource CaptionTextStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" x:Name="OnlineDownloadProgressPanel" Width="240" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="OnlineDownloadProgressTextBlock" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar x:Name="OnlineDownloadProgressBar" Minimum="0" Maximum="100" Height="4" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <StackPanel x:Name="OnlineLayoutTogglePanel" Orientation="Horizontal" Spacing="2" Padding="2" CornerRadius="8" Background="{ThemeResource AppInsetBackgroundBrush}">
                                    <Button
                                        x:Name="OnlineListLayoutButton"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        Click="OnOnlineListLayoutClicked"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <FontIcon FontSize="15" Glyph="&#xEA37;" />
                                    </Button>
                                    <Button
                                        x:Name="OnlineGridLayoutButton"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        Click="OnOnlineGridLayoutClicked"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <FontIcon FontSize="15" Glyph="&#xECA5;" />
                                    </Button>
                                </StackPanel>
                                <Button
                                    x:Name="RefreshOnlineButton" x:FieldModifier="internal"
                                    Click="OnRefreshOnlineModsClicked"
                                    MinHeight="36"
                                    MinWidth="36"
                                    Padding="10,4"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                        <TextBlock x:Name="RefreshOnlineButtonTextBlock" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid
                            x:Name="OnlineWorkspaceGrid"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="12"
                            RowSpacing="12"
                            SizeChanged="OnOnlineWorkspaceGridSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OnlineCharacterRailColumn" Width="188" />
                                <ColumnDefinition x:Name="OnlineResultsColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="OnlineCharacterRailRow" Height="*" />
                                <RowDefinition x:Name="OnlineResultsRow" Height="0" />
                            </Grid.RowDefinitions>

                            <Border x:Name="OnlineCharacterRailHost" Grid.Column="0" Style="{StaticResource InsetBorderStyle}" Padding="10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        x:Name="OnlineCharacterRailTitleTextBlock"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        TextAlignment="Left"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <ScrollViewer
                                        x:Name="OnlineCharacterRailScrollViewer"
                                        Grid.Row="1"
                                        Padding="0,0,2,0"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Disabled"
                                        VerticalContentAlignment="Stretch"
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Enabled">
                                        <StackPanel
                                            x:Name="OnlineCharacterAvatarPanel"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,10,0"
                                            Orientation="Vertical"
                                            Spacing="6" />
                                    </ScrollViewer>
                                    <TextBlock
                                        x:Name="OnlineCharacterRailHintTextBlock"
                                        Grid.Row="2"
                                        Style="{StaticResource CaptionTextStyle}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <Grid
                                x:Name="OnlineResultsHost"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                MinWidth="0"
                                RowSpacing="8"
                                SizeChanged="OnOnlineResultsHostSizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Search, sort, then the page filters and options. When the search box would get too
                                     narrow it takes a row of its own; without the character rail the character list joins
                                     the second row (OnlinePage.UpdateOnlineToolbarLayout). -->
                                <Grid x:Name="OnlineToolbarGrid" ColumnSpacing="8" RowSpacing="0" Canvas.ZIndex="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="OnlineSortColumn" Width="176" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- A failed list load: what went wrong and a retry, above the results (no dialog). -->
                                    <InfoBar
                                        x:Name="OnlineErrorInfoBar"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Margin="0,8,0,0"
                                        Severity="Error"
                                        IsOpen="False"
                                        Visibility="Collapsed" />
                                    <TextBox
                                        x:Name="OnlineSearchTextBox" x:FieldModifier="internal"
                                        MinHeight="36"
                                        Padding="12,7"
                                        TextChanged="OnOnlineSearchTextChanged" />
                                    <ComboBox
                                        x:Name="OnlineCharacterComboBox"
                                        Visibility="Collapsed"
                                        MinHeight="36"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="OnOnlineCharacterSelectionChanged" />
                                    <ComboBox
                                        x:Name="OnlineSortComboBox" x:FieldModifier="internal"
                                        Grid.Column="1"
                                        MinHeight="36"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="OnOnlineSortSelectionChanged" />
                                    <StackPanel x:Name="OnlineToolbarButtonsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="OnlineWorkFilterButton" MinHeight="36" Padding="10,2" Click="OnOnlineWorkFilterClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="ClearOnlineFiltersButton" MinHeight="36" Padding="10,2" Click="OnClearOnlineFiltersClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="OnlineSavedItemsButton" Width="36" Height="36" Padding="0" Click="OnOnlineSavedItemsClicked" Style="{StaticResource SecondaryButtonStyle}"><FontIcon FontSize="14" Glyph="&#xE734;" /></Button>
                                        <Button x:Name="OnlineDownloadOptionsButton" Width="36" Height="36" Padding="0" Click="OnOnlineDownloadOptionsClicked" Style="{StaticResource SecondaryButtonStyle}"><FontIcon FontSize="14" Glyph="&#xE713;" /></Button>
                                    </StackPanel>
                                </Grid>
                                <ListView
                                    x:Name="OnlineVirtualizedListView" x:FieldModifier="internal"
                                    Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    MinHeight="0"
                                    Canvas.ZIndex="0"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnOnlineResultItemClick"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollMode="Enabled"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0,0,12,7" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl
                                                HorizontalContentAlignment="Stretch"
                                                Tag="OnlineListCardPresenter"
                                                DataContextChanged="OnOnlineListCardPresenterDataContextChanged" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                </ListView>
                                <!-- Item size comes from OnlineLayoutPolicy.GridTiles; clicking a tile (or Enter) opens its details. -->
                                <GridView
                                    x:Name="OnlineVirtualizedGridView" x:FieldModifier="internal"
                                    SizeChanged="OnOnlineGridSizeChanged"
                                    Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    MinHeight="0"
                                    Canvas.ZIndex="0"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnOnlineResultItemClick"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollMode="Enabled"
                                    SelectionMode="None"
                                    Visibility="Collapsed">
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="OnlineGridCardPresenter"
                                                DataContextChanged="OnOnlineGridCardPresenterDataContextChanged" />
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid ItemWidth="300" ItemHeight="307" Orientation="Horizontal" Loaded="OnOnlineGridPanelLoaded" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                                <ContentControl
                                    x:Name="OnlineEmptyResultsContentControl"
                                    Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                    Margin="0,0,12,0"
                                    Visibility="Collapsed" />
                                <!-- Loading: placeholder cards shaped like the current view, with the ring and text over them. -->
                                <Grid
                                    x:Name="OnlineLoadingOverlay"
                                    Grid.Row="1"
                                    Background="{ThemeResource AppCardBackgroundBrush}"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                    <ContentControl
                                        x:Name="OnlineLoadingPlaceholderHost"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top"
                                        IsTabStop="False"
                                        Opacity="0.6" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="20,16" CornerRadius="8" Background="{ThemeResource AppCardBackgroundBrush}">
                                        <ProgressRing Width="36" Height="36" IsActive="True" />
                                        <TextBlock x:Name="OnlineLoadingTextBlock" Style="{StaticResource MutedTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
            <!-- Transparent: only the drawer's ThemeShadow falls on it (a shadow outside a popup needs a receiver). -->
            <Border x:Name="OnlineDetailShadowReceiver" Grid.Row="1" Background="Transparent" IsHitTestVisible="False" Canvas.ZIndex="9" />
            <Grid
                x:Name="OnlineDetailDrawer" x:FieldModifier="internal"
                Grid.Row="1"
                Width="600"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                Canvas.ZIndex="10">
                <Border x:Name="OnlineDetailPaneBorder" Style="{StaticResource DetailPaneBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource InsetBorderStyle}" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OnlineDetailPaneTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="Wrap" />
                                    <!-- Step through the Mods shown on this page without closing the drawer. -->
                                    <Button
                                        x:Name="OnlineDetailPreviousButton"
                                        Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Click="OnOnlineDetailPreviousClicked"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <FontIcon FontSize="14" Glyph="&#xE76B;" />
                                    </Button>
                                    <Button
                                        x:Name="OnlineDetailNextButton"
                                        Grid.Column="2"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Click="OnOnlineDetailNextClicked"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <FontIcon FontSize="14" Glyph="&#xE76C;" />
                                    </Button>
                                    <Button
                                        x:Name="CloseOnlineDetailButton"
                                        Grid.Column="3"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Click="OnCloseOnlineDetailsClicked"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="OnlineDetailPaneMetaTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="OnlineDetailPaneStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,14,0" Spacing="12">
                                <Border x:Name="OnlineDetailHeroBorder" Background="{ThemeResource AppPreviewBackgroundBrush}" CornerRadius="12" Height="360">
                                    <Grid>
                                        <Image x:Name="OnlineDetailHeroImage" x:FieldModifier="internal" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed" ImageOpened="OnOnlineDetailHeroImageOpened" Tapped="OnOnlineDetailHeroImageTapped" />
                                        <TextBlock
                                            x:Name="OnlineDetailHeroPlaceholderTextBlock"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                </Border>

                                <ScrollViewer x:Name="OnlineDetailThumbnailScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                    <StackPanel x:Name="OnlineDetailThumbnailPanel" Margin="0,0,0,12" Orientation="Horizontal" Spacing="8" />
                                </ScrollViewer>

                                <Border x:Name="OnlineDetailRequirementBorder" Style="{StaticResource InsetBorderStyle}" Visibility="Collapsed">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="OnlineDetailRequirementTitleTextBlock" x:FieldModifier="internal" FontWeight="SemiBold" />
                                        <TextBlock x:Name="OnlineDetailRequirementTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="OnlineDetailSummaryTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="OnlineDetailTranslationNoteTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                                <TextBlock x:Name="OnlineDetailDescriptionTextBlock" TextWrapping="Wrap" />

                                <Border Style="{StaticResource InsetBorderStyle}" Padding="12">
                                    <TextBlock x:Name="OnlineDetailDownloadHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Style="{StaticResource StickyActionBorderStyle}">
                            <StackPanel Spacing="9">
                                <TextBlock
                                    x:Name="OnlineDetailDownloadSelectionTextBlock"
                                    Style="{StaticResource CaptionTextStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <!-- One main action, the file choice beside it, and the source page as a link. -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="DownloadOnlineDetailButton" x:FieldModifier="internal"
                                        Click="OnDownloadOnlineDetailClicked"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="40"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button
                                        x:Name="SelectOnlineDetailDownloadButton" x:FieldModifier="internal"
                                        Grid.Column="1"
                                        Click="OnSelectOnlineDetailDownloadClicked"
                                        MinHeight="40"
                                        MinWidth="120"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <HyperlinkButton
                                    x:Name="OpenOnlineDetailPageButton" x:FieldModifier="internal"
                                    Click="OnOpenOnlineDetailPageClicked"
                                    Padding="4,2"
                                    Margin="-4,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
                                <!-- Footer: what this page shows, then paging. -->
                                <Grid Grid.Row="2" ColumnSpacing="8" Canvas.ZIndex="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OnlineFilterSummaryTextBlock" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextStyle}" />
                                    <Button
                                        x:Name="OnlinePrevPageButton" x:FieldModifier="internal"
                                        Grid.Column="1"
                                        Click="OnOnlinePrevPageClicked"
                                        MinHeight="32"
                                        MinWidth="96"
                                        Padding="12,4"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock
                                        x:Name="OnlinePaginationTextBlock"
                                        Grid.Column="2"
                                        Margin="6,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextStyle}" />
                                    <Button
                                        x:Name="OnlineNextPageButton" x:FieldModifier="internal"
                                        Grid.Column="3"
                                        Click="OnOnlineNextPageClicked"
                                        MinHeight="32"
                                        MinWidth="96"
                                        Padding="12,4"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</UserControl>
