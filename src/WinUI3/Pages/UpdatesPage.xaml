<UserControl
    x:Class="ModFolderCopier.WinUI.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModFolderCopier.WinUI"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- Stage J3 (docs/development/UI-Structure-Plan.md): the Updates page, moved out of MainWindow.xaml.
         It shows UpdatesViewModel and the download tasks, and sends clicks to the window through the view model. -->
    <ScrollViewer x:Name="UpdatesScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6" Spacing="16">
            <local:PageHeader x:Name="UpdatesPageHeader" />

            <Grid x:Name="UpdatesTopGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="UpdatesPrimaryColumn" Width="1.35*" />
                    <ColumnDefinition x:Name="UpdatesSecondaryColumn" Width="0.85*" />
                    <ColumnDefinition x:Name="UpdatesTertiaryColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="UpdatesMainPanel" Grid.Column="0" Spacing="16">
                    <Border x:Name="UpdatesTrackedModsCard" Style="{StaticResource CardBorderStyle}">
                        <!-- Header, settings and filters stay put; only the list scrolls, so many Mods never stretch the page. -->
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <FontIcon Glyph="&#xE895;" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="TrackedModsTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="TrackedModsSummaryTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="CheckModUpdatesButton"
                                Grid.Column="2"
                                Click="OnCheckModUpdatesClicked"
                                MinHeight="42"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource InsetBorderStyle}" Padding="12,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TrackedModSettingsTitleTextBlock" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ModUpdateStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <!-- The longer explanations live in the interval box's tooltip. -->
                                    <TextBlock x:Name="TrackedModSettingsHintTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="ModUpdateIntervalHintTextBlock" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ModUpdateIntervalLabelTextBlock" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox
                                        x:Name="ModUpdateIntervalComboBox"
                                        MinHeight="36"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="OnModUpdateIntervalSelectionChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="TrackedModsFilterPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                            <TextBox x:Name="TrackedModsSearchBox" Grid.Column="1" MinWidth="0" TextChanged="OnTrackedModsSearchChanged" />
                        </Grid>
                        <Grid Grid.Row="3">
                            <ScrollViewer
                                x:Name="TrackedModsListScroll"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater x:Name="TrackedModsRepeater" Margin="0,0,10,0">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <ContentControl x:Name="TrackedModsEmptyHost" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" IsTabStop="False" />
                        </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- The support column scrolls on its own when the columns fill the window. -->
                <ScrollViewer
                    x:Name="UpdatesSupportScroll"
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="UpdatesSupportPanel" Spacing="16" Margin="0,0,6,0">
                    <!-- On very wide pages this card moves into its own middle column. -->
                    <Border x:Name="UpdatesDownloadsCard" Style="{StaticResource CardBorderStyle}">
                        <!-- Finished, failed and canceled downloads; the list scrolls inside the card. -->
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="DownloadTaskCenterTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="DownloadTaskCenterHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ClearDownloadTasksButton" Grid.Column="1" Click="OnClearDownloadTasksClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <StackPanel x:Name="DownloadHistoryFilterPanel" Grid.Row="1" Orientation="Horizontal" Spacing="6" />
                            <TextBlock x:Name="DownloadHistoryRunningTextBlock" Grid.Row="2" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <Grid Grid.Row="3">
                                <ScrollViewer
                                    x:Name="DownloadHistoryListScroll"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsRepeater x:Name="DownloadHistoryRepeater" Margin="0,0,10,0">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="6" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </ScrollViewer>
                                <ContentControl x:Name="DownloadHistoryEmptyHost" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" IsTabStop="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="UpdatesSafetyCard" Style="{StaticResource CardBorderStyle}">
                        <StackPanel x:Name="UpdatesSafetyPanel" Spacing="12">
                            <TextBlock x:Name="InstallSafetyTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="InstallSafetyHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="ConflictDetectionToggleSwitch" Toggled="OnConflictDetectionToggled" />
                            <!-- Recovery actions share one equal-width row. -->
                            <Grid x:Name="UpdatesRecoveryActionsGrid" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RollbackLastInstallButton" Click="OnRollbackLastInstallClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                                <!-- Restoring a preset is a recovery action: it sits beside "Undo last change"; the presets are in the Mod workspace. -->
                                <Button x:Name="OpenCombinationPresetsButton" Grid.Column="1" Click="OnOpenCombinationPresetsClicked" HorizontalAlignment="Stretch"
                                        MinHeight="34" CornerRadius="4" Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock x:Name="OpenCombinationPresetsTextBlock" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="InstallRollbackStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="UpdatesBackupCard" Style="{StaticResource CardBorderStyle}">
                        <StackPanel x:Name="UpdatesBackupPanel" Spacing="12">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="BackupManagerTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="BackupManagerHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Controls get their own row so the description keeps the full card width. -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BackupLimitLabelTextBlock" VerticalAlignment="Center" />
                                <NumberBox
                                    x:Name="BackupLimitNumberBox"
                                    Grid.Column="1"
                                    Width="110"
                                    Minimum="0.5"
                                    Maximum="100"
                                    SmallChange="0.5"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="OnBackupLimitValueChanged" />
                                <Button
                                    x:Name="RefreshBackupsButton"
                                    Grid.Column="3"
                                    Click="OnRefreshBackupsClicked"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <Expander
                                x:Name="BackupHistoryExpander"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock x:Name="BackupSummaryTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </Expander.Header>
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="BackupListPanel" Spacing="10" Margin="0,8,0,0" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
