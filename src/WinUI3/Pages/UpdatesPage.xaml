<UserControl
    x:Class="ModFolderCopier.WinUI.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- Stage J3-b (docs/development/UI-Fluent-Design-Plan.md, "更新（J3）"): a status area like Windows Update,
         then a selector bar with three views, each with one scroll area. The page shows UpdatesViewModel and the
         download tasks, and sends clicks to the window through the view model. -->
    <Grid x:Name="UpdatesRootGrid" Margin="6" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:PageHeader x:Name="UpdatesPageHeader" />

        <!-- Status: what the last check found, when it ran, and the check button. -->
        <Border x:Name="UpdatesStatusCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="UpdatesStatusIconBorder" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Center">
                    <FontIcon x:Name="UpdatesStatusGlyph" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="ModUpdateStatusTextBlock" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="TrackedModsSummaryTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="CheckModUpdatesButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OnCheckModUpdatesClicked"
                    Style="{StaticResource PrimaryButtonStyle}" />
                <!-- Loading and error states of the check. -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="8" x:Name="UpdatesStatusDetailsPanel">
                    <ProgressBar x:Name="UpdatesCheckProgressBar" IsIndeterminate="True" Visibility="Collapsed" />
                    <InfoBar x:Name="UpdatesCheckInfoBar" IsClosable="False" IsOpen="False" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <SelectorBar x:Name="UpdatesViewSelector" Grid.Row="2" SelectionChanged="OnUpdatesViewSelectionChanged">
            <SelectorBarItem x:Name="UpdatesViewMods" Tag="Mods" />
            <SelectorBarItem x:Name="UpdatesViewDownloads" Tag="Downloads" />
            <SelectorBarItem x:Name="UpdatesViewRecovery" Tag="Recovery" />
        </SelectorBar>

        <Grid Grid.Row="3">
            <!-- Mod updates: filter and search, the tracked Mods, and how often they are checked. -->
            <ScrollViewer x:Name="ModsViewScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Margin="0,0,12,12">
                    <Grid x:Name="TrackedModsToolbar" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>
                        <toolkit:Segmented x:Name="TrackedModsFilterSegmented" HorizontalAlignment="Left" SelectionChanged="OnTrackedModsFilterChanged" />
                        <TextBox x:Name="TrackedModsSearchBox" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" TextChanged="OnTrackedModsSearchChanged" />
                    </Grid>
                    <ItemsRepeater x:Name="TrackedModsRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ContentControl x:Name="TrackedModsEmptyHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                    <toolkit:SettingsCard x:Name="ModUpdateIntervalSettingsCard">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE823;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ModUpdateIntervalComboBox" MinWidth="200" SelectionChanged="OnModUpdateIntervalSelectionChanged" />
                    </toolkit:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Download history: finished, failed and canceled downloads; running ones are in the navigation's flyout. -->
            <ScrollViewer x:Name="DownloadsViewScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="12" Margin="0,0,12,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="DownloadTaskCenterHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DownloadHistoryRunningTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <Button x:Name="ClearDownloadTasksButton" Grid.Column="1" VerticalAlignment="Top" Click="OnClearDownloadTasksClicked" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <toolkit:Segmented x:Name="DownloadHistoryFilterSegmented" HorizontalAlignment="Left" SelectionChanged="OnDownloadHistoryFilterChanged" />
                    <ItemsRepeater x:Name="DownloadHistoryRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ContentControl x:Name="DownloadHistoryEmptyHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- Install and recovery: settings cards for conflict checks, undo, presets and backups. -->
            <ScrollViewer x:Name="RecoveryViewScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="4" Margin="0,0,12,12">
                    <toolkit:SettingsCard x:Name="ConflictDetectionSettingsCard">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7BA;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="ConflictDetectionToggleSwitch" Toggled="OnConflictDetectionToggled" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="RollbackLastInstallButton" IsClickEnabled="True" Click="OnRollbackLastInstallClicked">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7A7;" />
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="OpenCombinationPresetsButton" IsClickEnabled="True" Click="OnOpenCombinationPresetsClicked">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsExpander x:Name="BackupHistoryExpander">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="BackupLimitLabelTextBlock" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                            <NumberBox
                                x:Name="BackupLimitNumberBox"
                                Width="110"
                                Minimum="0.5"
                                Maximum="100"
                                SmallChange="0.5"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnBackupLimitValueChanged" />
                        </StackPanel>
                    </toolkit:SettingsExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
