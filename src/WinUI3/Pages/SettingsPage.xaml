<UserControl
    x:Class="ModFolderCopier.WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModFolderCopier.WinUI"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- Stage J2 (docs/development/UI-Structure-Plan.md): the Settings page, moved out of MainWindow.xaml.
         It shows SettingsViewModel and sends clicks to the window through it. -->
    <ScrollViewer
        x:Name="SettingsScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
        <StackPanel x:Name="SettingsRootPanel" Margin="2,2,8,2" Spacing="12" MaxWidth="3200" HorizontalAlignment="Stretch">
            <local:PageHeader x:Name="SettingsPageHeader" />

            <!-- Section list beside or above one card; on wide pages the list hides and the cards form a two-column overview. -->
            <Grid x:Name="SettingsResponsiveGrid" ColumnSpacing="10" RowSpacing="10">
                <Border x:Name="SettingsNavigationCard" Style="{StaticResource CardBorderStyle}" Padding="10" VerticalAlignment="Top">
                    <Grid x:Name="SettingsNavigationGrid" RowSpacing="8" ColumnSpacing="8">
                        <Button x:Name="SettingsSectionButton0" AutomationProperties.AutomationId="SettingsSection0" Click="OnSettingsSectionClicked"
                                Style="{StaticResource SecondaryButtonStyle}" MinHeight="48" Padding="14,10,14,10"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE790;" FontSize="17" />
                                <TextBlock x:Name="SettingsSectionLabel0" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsSectionButton1" AutomationProperties.AutomationId="SettingsSection1" Click="OnSettingsSectionClicked"
                                Style="{StaticResource SecondaryButtonStyle}" MinHeight="48" Padding="14,10,14,10"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE895;" FontSize="17" />
                                <TextBlock x:Name="SettingsSectionLabel1" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsSectionButton2" AutomationProperties.AutomationId="SettingsSection2" Click="OnSettingsSectionClicked"
                                Style="{StaticResource SecondaryButtonStyle}" MinHeight="48" Padding="14,10,14,10"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE774;" FontSize="17" />
                                <TextBlock x:Name="SettingsSectionLabel2" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsSectionButton3" AutomationProperties.AutomationId="SettingsSection3" Click="OnSettingsSectionClicked"
                                Style="{StaticResource SecondaryButtonStyle}" MinHeight="48" Padding="14,10,14,10"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE9D9;" FontSize="17" />
                                <TextBlock x:Name="SettingsSectionLabel3" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsSectionButton4" AutomationProperties.AutomationId="SettingsSection4" Click="OnSettingsSectionClicked"
                                Style="{StaticResource SecondaryButtonStyle}" MinHeight="48" Padding="14,10,14,10"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE71B;" FontSize="17" />
                                <TextBlock x:Name="SettingsSectionLabel4" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="SettingsSectionScrollViewer" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalAlignment="Top">
                    <Grid VerticalAlignment="Top">
                        <Grid x:Name="SettingsOverviewGrid" ColumnSpacing="10" VerticalAlignment="Top" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="SettingsOverviewLeftColumn" Spacing="10" />
                            <StackPanel x:Name="SettingsOverviewRightColumn" Grid.Column="1" Spacing="10" />
                        </Grid>
                        <Grid x:Name="SettingsFocusHost" VerticalAlignment="Top">
                            <Border x:Name="SettingsAppearanceCard" Style="{StaticResource CardBorderStyle}" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="SettingsAppearanceTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                    <StackPanel Spacing="8">
                                        <local:SettingRow x:Name="LanguageSettingRow" Glyph="&#xE774;">
                                            <local:SettingRow.Action>
                                                <ComboBox
                                                    x:Name="LanguageComboBox"
                                                    IsEnabled="{x:Bind ViewModel.CanChangeAppearance, Mode=OneWay}"
                                                    MinWidth="160"
                                                    ItemsSource="{x:Bind ViewModel.Appearance.LanguageOptions, Mode=OneWay}"
                                                    SelectedIndex="{x:Bind ViewModel.Appearance.LanguageIndex, Mode=TwoWay}" />
                                            </local:SettingRow.Action>
                                        </local:SettingRow>
                                        <local:SettingRow x:Name="ThemeSettingRow" Glyph="&#xE790;">
                                            <local:SettingRow.Action>
                                                <ComboBox
                                                    x:Name="ThemeComboBox"
                                                    IsEnabled="{x:Bind ViewModel.CanChangeAppearance, Mode=OneWay}"
                                                    MinWidth="160"
                                                    ItemsSource="{x:Bind ViewModel.Appearance.ThemeOptions, Mode=OneWay}"
                                                    SelectedIndex="{x:Bind ViewModel.Appearance.ThemeIndex, Mode=TwoWay}" />
                                            </local:SettingRow.Action>
                                        </local:SettingRow>
                                        <local:SettingRow x:Name="DensitySettingRow" Glyph="&#xE8A9;">
                                            <local:SettingRow.Action>
                                                <ComboBox
                                                    x:Name="DensityComboBox"
                                                    MinWidth="160"
                                                    ItemsSource="{x:Bind ViewModel.Appearance.DensityOptions, Mode=OneWay}"
                                                    SelectedIndex="{x:Bind ViewModel.Appearance.DensityIndex, Mode=TwoWay}" />
                                            </local:SettingRow.Action>
                                        </local:SettingRow>
                                        <local:SettingRow x:Name="MotionSettingRow" Glyph="&#xE786;">
                                            <local:SettingRow.Action>
                                                <ToggleSwitch
                                                    x:Name="ReduceMotionToggleSwitch"
                                                    IsOn="{x:Bind ViewModel.Appearance.ReduceMotion, Mode=TwoWay}" />
                                            </local:SettingRow.Action>
                                        </local:SettingRow>
                                        <local:SettingRow x:Name="TraySettingRow" Glyph="&#xE8B7;">
                                            <local:SettingRow.Action>
                                                <ToggleSwitch x:Name="MinimizeToTrayToggleSwitch" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                                            </local:SettingRow.Action>
                                        </local:SettingRow>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SettingsAppUpdatesCard" Style="{StaticResource CardBorderStyle}" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="SettingsProjectTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="SettingsProjectHintTextBlock" Style="{StaticResource CaptionTextStyle}" MaxLines="2" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Border Style="{StaticResource SettingRowBorderStyle}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE895;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock x:Name="StartupUpdateTitleTextBlock" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StartupUpdateDescriptionTextBlock" Style="{StaticResource CaptionTextStyle}" MaxLines="2" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="StartupUpdateToggleSwitch" Grid.Column="2" VerticalAlignment="Center"
                                            IsOn="{x:Bind ViewModel.CheckOnStartup, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SelfUpdateEnabled, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="UpdateCheckIntervalLabelTextBlock"
                                            VerticalAlignment="Center" />

                                        <ComboBox
                                            x:Name="UpdateCheckIntervalComboBox"
                                            Grid.Column="1"
                                            MinHeight="42"
                                            IsEnabled="{x:Bind ViewModel.SelfUpdateEnabled, Mode=OneWay}"
                                            SelectionChanged="OnUpdateCheckIntervalSelectionChanged" />
                                    </Grid>
                                    <TextBlock x:Name="UpdateCheckIntervalHintTextBlock" Style="{StaticResource CaptionTextStyle}" MaxLines="2" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Grid x:Name="AppUpdateActionsGrid" ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="AppUpdateActionColumn1" Width="*" />
                                            <ColumnDefinition x:Name="AppUpdateActionColumn2" Width="*" />
                                            <ColumnDefinition x:Name="AppUpdateActionColumn3" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button
                                            x:Name="OpenGitHubButton"
                                            HorizontalAlignment="Stretch"
                                            Click="OnOpenGitHubClicked"
                                            MinHeight="42"
                                            Style="{StaticResource SecondaryButtonStyle}" />

                                        <Button
                                            x:Name="CheckUpdatesButton"
                                            HorizontalAlignment="Stretch"
                                            Grid.Column="1"
                                            Click="OnCheckUpdatesClicked"
                                            IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}"
                                            MinHeight="42"
                                            Style="{StaticResource SecondaryButtonStyle}" />

                                        <Button
                                            x:Name="InstallUpdateButton"
                                            HorizontalAlignment="Stretch"
                                            Grid.Column="2"
                                            Click="OnInstallUpdateClicked"
                                            MinHeight="42"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="UpdateStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                   Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasUpdateStatus, Mode=OneWay}" />
                                    <StackPanel x:Name="AppUpdateProgressPanel" Spacing="6" Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay}">
                                        <TextBlock x:Name="AppUpdateProgressTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.DownloadText, Mode=OneWay}" />
                                        <ProgressBar x:Name="AppUpdateProgressBar" Minimum="0" Maximum="100" Height="8"
                         IsIndeterminate="{x:Bind ViewModel.IsDownloadProgressIndeterminate, Mode=OneWay}" Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource InsetBorderStyle}" Padding="12,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="LatestReleaseTitleTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Bind ViewModel.ReleaseTitle, Mode=OneWay}" />
                                            <TextBlock x:Name="LatestReleaseMetaTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.ReleaseMeta, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasReleaseDetails, Mode=OneWay}" />
                                            <ScrollViewer x:Name="UpdateNotesScrollViewer" MaxHeight="150" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasReleaseDetails, Mode=OneWay}">
                                                <TextBlock x:Name="UpdateNotesTextBlock" TextWrapping="Wrap" Text="{x:Bind ViewModel.ReleaseNotes, Mode=OneWay}" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SettingsOnlineCard" Style="{StaticResource CardBorderStyle}" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="SettingsPlaceholderTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="SettingsPlaceholderTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.OnlineSummary, Mode=OneWay}" />
                                    <!-- One compact table, split into two halves side by side so it stays short. -->
                                    <Grid x:Name="SettingsOnlineInfoGrid" ColumnSpacing="24">
                                        <Grid.Resources>
                                            <DataTemplate x:Key="SettingInfoItemTemplate" x:DataType="local:SettingInfoItem">
                                                <Grid ColumnSpacing="12" Padding="0,5" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Value}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl x:Name="SettingsOnlineInfoList" ItemTemplate="{StaticResource SettingInfoItemTemplate}" ItemsSource="{x:Bind ViewModel.OnlineInfoFirstHalf, Mode=OneWay}" />
                                        <ItemsControl x:Name="SettingsOnlineInfoList2" Grid.Column="1" ItemTemplate="{StaticResource SettingInfoItemTemplate}" ItemsSource="{x:Bind ViewModel.OnlineInfoSecondHalf, Mode=OneWay}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            x:Name="EditOnlineRepositoryButton"
                                            Click="OnEditOnlineRepositoryClicked"
                                            MinHeight="42"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button
                                            x:Name="EditCharacterMappingsButton"
                                            Click="OnEditCharacterMappingsClicked"
                                            MinHeight="42"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SettingsDiagnosticsCard" Style="{StaticResource CardBorderStyle}" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="DiagnosticsTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="DiagnosticsHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ExportDiagnosticsButton" HorizontalAlignment="Stretch" Click="OnExportDiagnosticsClicked" MinHeight="42" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="SubmitDiagnosticsButton" HorizontalAlignment="Stretch" Grid.Column="1" Click="OnSubmitDiagnosticsClicked" MinHeight="42" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                    <Border Style="{StaticResource InsetBorderStyle}" Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8BD;" FontSize="18" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="FeedbackGroupTitleTextBlock" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                                <TextBlock x:Name="FeedbackGroupNumberTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                            <Button x:Name="CopyFeedbackGroupButton" Grid.Column="2" Click="OnCopyFeedbackGroupClicked" MinHeight="36" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource InsetBorderStyle}" Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8BD;" FontSize="18" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="FeedbackDiscordTitleTextBlock" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                                <TextBlock x:Name="FeedbackDiscordHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="OpenFeedbackDiscordButton" Grid.Column="2" Click="OnOpenFeedbackDiscordClicked" MinHeight="36" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="DiagnosticsStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
               Text="{x:Bind ViewModel.DiagnosticsStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDiagnosticsStatus, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ProjectResourcesCard" Style="{StaticResource CardBorderStyle}" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="ProjectResourcesTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="ProjectResourcesHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <Grid x:Name="ProjectResourcesGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button
                                            Tag="https://www.7-zip.org/"
                                            Click="OnExternalResourceClicked"
                                            MinHeight="54"
                                            Padding="12,7"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="7-Zip" FontWeight="SemiBold" />
                                                <TextBlock Text="https://www.7-zip.org/" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Column="1"
                                            Tag="https://github.com/microsoft/WindowsAppSDK"
                                            Click="OnExternalResourceClicked"
                                            MinHeight="54"
                                            Padding="12,7"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Windows App SDK / WinUI&#160;3" FontWeight="SemiBold" />
                                                <TextBlock Text="https://github.com/microsoft/WindowsAppSDK" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Column="2"
                                            Tag="https://www.sqlite.org/"
                                            Click="OnExternalResourceClicked"
                                            MinHeight="54"
                                            Padding="12,7"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="SQLite / Microsoft.Data.Sqlite" FontWeight="SemiBold" />
                                                <TextBlock Text="https://www.sqlite.org/" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Row="1"
                                            Tag="https://github.com/libarchive/libarchive"
                                            Click="OnExternalResourceClicked"
                                            MinHeight="54"
                                            Padding="12,7"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="libarchive / Windows tar" FontWeight="SemiBold" />
                                                <TextBlock Text="https://github.com/libarchive/libarchive" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Row="1"
                                            Tag="https://github.com/CommunityToolkit/dotnet"
                                            Click="OnExternalResourceClicked"
                                            MinHeight="54"
                                            Padding="12,7"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="CommunityToolkit.Mvvm" FontWeight="SemiBold" />
                                                <TextBlock Text="https://github.com/CommunityToolkit/dotnet" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Tag="https://github.com/uyujkk/Integrated_Mod_Manager"
                                            Click="OnExternalResourceClicked"
                                            MinHeight="54"
                                            Padding="12,7"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Integrated Mod Manager · GitHub" FontWeight="SemiBold" />
                                                <TextBlock Text="https://github.com/uyujkk/Integrated_Mod_Manager" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Tag="https://space.bilibili.com/476698898"
                                            Click="OnExternalResourceClicked"
                                            MinHeight="54"
                                            Padding="12,7"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="B站主页 / Bilibili" FontWeight="SemiBold" />
                                                <TextBlock Text="https://space.bilibili.com/476698898" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
