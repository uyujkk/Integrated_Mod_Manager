<UserControl
    x:Class="ModFolderCopier.WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- Stage J2 (docs/development/UI-Structure-Plan.md, UI-Fluent-Design-Plan.md "设置（J2）"): one column of
         settings cards like Windows Settings, grouped under headings, at most 1000 px wide and left-aligned.
         The page shows SettingsViewModel and sends clicks to the window through it. -->
    <UserControl.Resources>
        <!-- A group heading: 30 px above, the cards 4 px apart below. -->
        <Style x:Key="SettingsGroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleTextStyle}">
            <Setter Property="Margin" Value="1,30,0,6" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="SettingsFirstGroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsGroupTitleStyle}">
            <Setter Property="Margin" Value="1,8,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="SettingsScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid Margin="2,2,12,24">
            <!-- The star column stops at 1000 px and leaves the rest of a wide window empty on the right. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SettingsRootPanel" Spacing="4">
                <local:PageHeader x:Name="SettingsPageHeader" />

                <!-- Appearance and language. -->
                <TextBlock x:Name="SettingsAppearanceTitleTextBlock" Style="{StaticResource SettingsFirstGroupTitleStyle}" />
                <toolkit:SettingsCard x:Name="LanguageSettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="LanguageComboBox"
                        IsEnabled="{x:Bind ViewModel.CanChangeAppearance, Mode=OneWay}"
                        MinWidth="160"
                        ItemsSource="{x:Bind ViewModel.Appearance.LanguageOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.Appearance.LanguageIndex, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="ThemeSettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ThemeComboBox"
                        IsEnabled="{x:Bind ViewModel.CanChangeAppearance, Mode=OneWay}"
                        MinWidth="160"
                        ItemsSource="{x:Bind ViewModel.Appearance.ThemeOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.Appearance.ThemeIndex, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="DensitySettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A9;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="DensityComboBox"
                        MinWidth="160"
                        ItemsSource="{x:Bind ViewModel.Appearance.DensityOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.Appearance.DensityIndex, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="MotionSettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE786;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ReduceMotionToggleSwitch" IsOn="{x:Bind ViewModel.Appearance.ReduceMotion, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="TraySettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="MinimizeToTrayToggleSwitch" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <!-- App updates, like Windows Update: the state and its buttons first, then the options. -->
                <TextBlock x:Name="SettingsAppUpdatesTitleTextBlock" Style="{StaticResource SettingsGroupTitleStyle}" />
                <toolkit:SettingsCard x:Name="AppUpdateStatusCard" Header="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdatesClicked" IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}" />
                        <Button x:Name="InstallUpdateButton" Click="OnInstallUpdateClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="AppUpdateProgressCard" Header="{x:Bind ViewModel.DownloadText, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ProgressBar x:Name="AppUpdateProgressBar" Width="200" Minimum="0" Maximum="100"
                                 IsIndeterminate="{x:Bind ViewModel.IsDownloadProgressIndeterminate, Mode=OneWay}"
                                 Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsExpander x:Name="ReleaseNotesExpander"
                                          Header="{x:Bind ViewModel.ReleaseTitle, Mode=OneWay}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Name="ReleaseNotesCard" HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="LatestReleaseMetaTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.ReleaseMeta, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasReleaseDetails, Mode=OneWay}" />
                                <TextBlock x:Name="UpdateNotesTextBlock" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Text="{x:Bind ViewModel.ReleaseNotes, Mode=OneWay}" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard x:Name="StartupUpdateSettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupUpdateToggleSwitch"
                                  IsOn="{x:Bind ViewModel.CheckOnStartup, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SelfUpdateEnabled, Mode=OneWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="UpdateCheckIntervalSettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE823;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="UpdateCheckIntervalComboBox"
                        MinWidth="160"
                        IsEnabled="{x:Bind ViewModel.SelfUpdateEnabled, Mode=OneWay}"
                        SelectionChanged="OnUpdateCheckIntervalSelectionChanged" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="OpenGitHubButton" IsClickEnabled="True" Click="OnOpenGitHubClicked"
                                      Description="https://github.com/uyujkk/Integrated_Mod_Manager">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>

                <!-- The current repository's online settings. -->
                <TextBlock x:Name="SettingsPlaceholderTitleTextBlock" Style="{StaticResource SettingsGroupTitleStyle}" />
                <toolkit:SettingsExpander x:Name="SettingsOnlineExpander"
                                          Description="{x:Bind ViewModel.OnlineSummary, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.OnlineInfo, Mode=OneWay}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="local:SettingInfoItem">
                            <toolkit:SettingsCard Header="{x:Bind Label}">
                                <TextBlock Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" MaxWidth="420"
                                           TextAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </toolkit:SettingsExpander.ItemTemplate>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard x:Name="EditOnlineRepositoryButton" IsClickEnabled="True" Click="OnEditOnlineRepositoryClicked">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE70F;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="EditCharacterMappingsButton" IsClickEnabled="True" Click="OnEditCharacterMappingsClicked">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE716;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>

                <!-- Diagnostics and feedback. -->
                <TextBlock x:Name="DiagnosticsTitleTextBlock" Style="{StaticResource SettingsGroupTitleStyle}" />
                <toolkit:SettingsCard x:Name="ExportDiagnosticsButton" IsClickEnabled="True" Click="OnExportDiagnosticsClicked">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="SubmitDiagnosticsButton" IsClickEnabled="True" Click="OnSubmitDiagnosticsClicked">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEBE8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="FeedbackGroupSettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Name="FeedbackGroupNumberTextBlock" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </toolkit:SettingsCard.Description>
                    <Button x:Name="CopyFeedbackGroupButton" Click="OnCopyFeedbackGroupClicked" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="FeedbackDiscordSettingsCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button x:Name="OpenFeedbackDiscordButton" Click="OnOpenFeedbackDiscordClicked" />
                </toolkit:SettingsCard>
                <TextBlock x:Name="DiagnosticsStatusTextBlock" Margin="1,4,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                           Text="{x:Bind ViewModel.DiagnosticsStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDiagnosticsStatus, Mode=OneWay}" />

                <!-- About: the version, then the project and the open-source components it uses. -->
                <TextBlock x:Name="ProjectResourcesTitleTextBlock" Style="{StaticResource SettingsGroupTitleStyle}" />
                <toolkit:SettingsExpander x:Name="AboutExpander">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="Integrated Mod Manager · GitHub">
                            <HyperlinkButton Content="github.com/uyujkk/Integrated_Mod_Manager" Tag="https://github.com/uyujkk/Integrated_Mod_Manager" Click="OnExternalResourceClicked" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="B站主页 / Bilibili">
                            <HyperlinkButton Content="space.bilibili.com/476698898" Tag="https://space.bilibili.com/476698898" Click="OnExternalResourceClicked" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Windows App SDK / WinUI&#160;3">
                            <HyperlinkButton Content="github.com/microsoft/WindowsAppSDK" Tag="https://github.com/microsoft/WindowsAppSDK" Click="OnExternalResourceClicked" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="CommunityToolkit.Mvvm">
                            <HyperlinkButton Content="github.com/CommunityToolkit/dotnet" Tag="https://github.com/CommunityToolkit/dotnet" Click="OnExternalResourceClicked" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="SQLite / Microsoft.Data.Sqlite">
                            <HyperlinkButton Content="www.sqlite.org" Tag="https://www.sqlite.org/" Click="OnExternalResourceClicked" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="7-Zip">
                            <HyperlinkButton Content="www.7-zip.org" Tag="https://www.7-zip.org/" Click="OnExternalResourceClicked" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="libarchive / Windows tar">
                            <HyperlinkButton Content="github.com/libarchive/libarchive" Tag="https://github.com/libarchive/libarchive" Click="OnExternalResourceClicked" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
