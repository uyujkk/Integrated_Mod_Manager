<UserControl
    x:Class="ModFolderCopier.WinUI.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- Stage J5 (docs/development/UI-Fluent-Design-Plan.md, "快捷键（J5）"), like the PowerToys keyboard and settings
         pages: a privilege InfoBar, setting cards for what to send where, one row per binding with its keys as key caps
         (KeyVisual), and the overlay, character follow and sending settings in expanders. The page shows
         ShortcutPageViewModel and sends clicks to the window through it. -->
    <UserControl.Resources>
        <Style x:Key="ShortcutsGroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,8,0,4" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="ShortcutsCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="ShortcutsScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ShortcutPaneContent" Margin="6" Spacing="12">
            <local:PageHeader x:Name="ShortcutsPageHeader">
                <local:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ShortcutsRefreshWindowsButton" Click="OnRefreshWindowsClicked" />
                        <Button x:Name="ShortcutsReloadIniButton" Click="OnReloadIniClicked" />
                    </StackPanel>
                </local:PageHeader.Actions>
            </local:PageHeader>

            <!-- Whether keys can reach the game; a warning with the restart button when they cannot. -->
            <InfoBar x:Name="ShortcutsPrivilegeInfoBar" IsOpen="True" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Name="ShortcutsElevateButton" Click="OnElevateClicked" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- What to send to which window. -->
            <StackPanel x:Name="ShortcutsTargetGroup" Spacing="4">
                <toolkit:SettingsCard x:Name="ShortcutsModCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ShortcutModPicker" MinWidth="240" MaxWidth="420" SelectionChanged="OnModPickerChanged" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="ShortcutsTargetCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ShortcutTargetPicker" MinWidth="240" MaxWidth="420" SelectionChanged="OnTargetPickerChanged" />
                        <Button x:Name="ShortcutsRefreshTargetsButton" Click="OnRefreshWindowsClicked">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="ShortcutsInputCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ShortcutInputToggle" Toggled="OnInputToggled" />
                </toolkit:SettingsCard>
            </StackPanel>

            <!-- Where keys go right now: the window, whether input is on, the input method and the overlay; the
                 message is the last read, send or capture result. -->
            <InfoBar x:Name="ShortcutsStatusInfoBar" IsOpen="True" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Name="ShortcutsStatusRefreshButton" Click="OnRefreshWindowsClicked" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The bindings, then the settings: one column at every width, so the setting cards have room. -->
            <StackPanel x:Name="ShortcutsBodyPanel" Spacing="12">
                <StackPanel x:Name="ShortcutsBindingsPanel" Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ShortcutsBindingsTitleTextBlock" Style="{StaticResource ShortcutsGroupTitleStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="ShortcutHideUnsupportedToggle" Grid.Column="1" MinWidth="0" Toggled="OnHideUnsupportedToggled" />
                        <Button x:Name="ShortcutsBindingsMoreButton" Grid.Column="2" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="ShortcutsOpenIniMenuItem" Click="OnOpenIniClicked">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ShortcutsReadOnlyHintTextBlock" Style="{StaticResource ShortcutsCaptionStyle}" />
                    <TextBlock x:Name="ShortcutsHiddenNoteTextBlock" Style="{StaticResource ShortcutsCaptionStyle}" Visibility="Collapsed" />
                    <StackPanel x:Name="ShortcutBindingsList" Spacing="4" Margin="0,4,0,0" />
                    <!-- Nothing to show: say what to do next. -->
                    <local:EmptyState x:Name="ShortcutsEmptyState" Glyph="&#xE765;" Visibility="Collapsed">
                        <local:EmptyState.Actions>
                            <Button x:Name="ShortcutsEmptyStateButton" Click="OnEmptyStateActionClicked" />
                        </local:EmptyState.Actions>
                    </local:EmptyState>
                </StackPanel>

                <StackPanel x:Name="ShortcutsSettingsColumn" Spacing="4">
                    <toolkit:SettingsExpander x:Name="ShortcutsOverlayExpander">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE7F4;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <Button x:Name="ShortcutsOpenOverlayButton" Click="OnOpenOverlayClicked" />
                        <toolkit:SettingsExpander.Items>
                            <!-- The global hotkey: on or off, and the chord, which takes effect as soon as it is chosen. -->
                            <toolkit:SettingsCard x:Name="ShortcutsHotkeyCard">
                                <ToggleSwitch x:Name="ShortcutHotkeyToggle" Toggled="OnHotkeyToggled" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsHotkeyChordCard">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="ShortcutHotkeyModifiersPicker" SelectionChanged="OnHotkeyPickerChanged" />
                                    <ComboBox x:Name="ShortcutHotkeyKeyPicker" SelectionChanged="OnHotkeyPickerChanged" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                        <toolkit:SettingsExpander.ItemsFooter>
                            <TextBlock x:Name="ShortcutsOverlayBehaviorNoteTextBlock" Margin="58,10,44,12" Style="{StaticResource ShortcutsCaptionStyle}" />
                        </toolkit:SettingsExpander.ItemsFooter>
                    </toolkit:SettingsExpander>

                    <!-- How the overlay looks in game; the description sums it up while folded. -->
                    <toolkit:SettingsExpander x:Name="ShortcutsOverlayLookExpander">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Name="ShortcutsOverlayPresetCard">
                                <StackPanel x:Name="ShortcutsOverlayPresetButtons" Orientation="Horizontal" Spacing="6" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsOverlayOpacityCard">
                                <Slider x:Name="ShortcutOverlayOpacitySlider" Width="200" StepFrequency="5" SmallChange="5" Maximum="100" ValueChanged="OnOverlayOpacityChanged" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsOverlayElementOpacityCard">
                                <Slider x:Name="ShortcutOverlayElementOpacitySlider" Width="200" StepFrequency="5" SmallChange="5" Minimum="0" Maximum="100" ValueChanged="OnOverlayElementOpacityChanged" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsOverlayTextColorCard">
                                <Button x:Name="ShortcutOverlayTextColorButton">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border x:Name="ShortcutOverlayTextColorSwatch" Width="18" Height="18" CornerRadius="3" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <TextBlock x:Name="ShortcutOverlayTextColorTextBlock" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="ShortcutOverlayTextColorFlyout" Closed="OnTextColorFlyoutClosed">
                                            <StackPanel Spacing="10">
                                                <TextBlock x:Name="ShortcutOverlayTextColorPresetsTextBlock" />
                                                <StackPanel x:Name="ShortcutOverlayTextColorPresets" Orientation="Horizontal" Spacing="6" />
                                                <ColorPicker x:Name="ShortcutOverlayTextColorPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                             IsColorChannelTextInputVisible="False" IsHexInputVisible="True" ColorChanged="OnTextColorPicked" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsOverlayAutoContrastCard">
                                <ToggleSwitch x:Name="ShortcutOverlayAutoContrastToggle" Toggled="OnOverlaySettingToggled" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <!-- State slots and presets used from the overlay: hot switching, pictures and what a slot keeps. -->
                    <toolkit:SettingsExpander x:Name="ShortcutsSlotsExpander">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Name="ShortcutsSlotSwitchCard">
                                <ToggleSwitch x:Name="ShortcutSlotSwitchToggle" Toggled="OnOverlaySettingToggled" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsCompactSlotsCard">
                                <ToggleSwitch x:Name="ShortcutCompactSlotsToggle" Toggled="OnOverlaySettingToggled" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsPresetPicturesCard">
                                <ToggleSwitch x:Name="ShortcutPresetPicturesToggle" Toggled="OnPresetPicturesToggled" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsClearRegionCard">
                                <Button x:Name="ShortcutClearRegionButton" Click="OnClearRegionClicked" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsKeepMenuStateCard">
                                <ToggleSwitch x:Name="ShortcutKeepMenuStateToggle" Toggled="OnOverlaySettingToggled" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsAutoSaveCard">
                                <ComboBox x:Name="ShortcutAutoSavePicker" MinWidth="160" SelectionChanged="OnAutoSaveChanged" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <toolkit:SettingsExpander x:Name="ShortcutsFollowExpander">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <ToggleSwitch x:Name="ShortcutCharacterFollowToggle" Toggled="OnCharacterFollowToggled" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Name="ShortcutsFollowSetupCard">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ShortcutSelectRegionButton" Click="OnSelectRegionClicked" />
                                    <Button x:Name="ShortcutSaveReferenceButton" Click="OnSaveReferenceClicked" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsFollowStatusCard" />
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <toolkit:SettingsExpander x:Name="ShortcutsSendingExpander">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE765;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Name="ShortcutsInputModeCard">
                                <ComboBox x:Name="ShortcutInputModePicker" MinWidth="200" SelectionChanged="OnInputModeChanged" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsTapDurationCard">
                                <NumberBox x:Name="ShortcutTapDurationBox" Minimum="100" Maximum="2000" SmallChange="100" MinWidth="120"
                                           SpinButtonPlacementMode="Compact" ValueChanged="OnDurationChanged" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsHoldDurationCard">
                                <NumberBox x:Name="ShortcutHoldDurationBox" Minimum="100" Maximum="2000" SmallChange="100" MinWidth="120"
                                           SpinButtonPlacementMode="Compact" ValueChanged="OnDurationChanged" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="ShortcutsNumLockCard">
                                <Button x:Name="ShortcutNumLockButton" Click="OnNumLockClicked" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
