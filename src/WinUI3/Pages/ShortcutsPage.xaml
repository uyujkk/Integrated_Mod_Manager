<UserControl
    x:Class="ModFolderCopier.WinUI.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!-- Stage J5 (docs/development/UI-Structure-Plan.md): the Shortcuts page. It is still built in code
         (ShortcutsPage.xaml.cs) as it was in the window; it shows ShortcutPageViewModel and sends clicks
         to the window through it. -->
    <ScrollViewer x:Name="ShortcutsScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ShortcutPaneContent" Margin="16" Spacing="14" />
    </ScrollViewer>
</UserControl>
