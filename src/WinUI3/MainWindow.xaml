<Window
    x:Class="ModFolderCopier.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Integrated Mod Manager v4.0.0"
    SizeChanged="OnWindowSizeChanged"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppPageBackgroundBrush}" KeyDown="OnRootKeyDown" PointerPressed="OnRootGridPointerPressed">
        <Grid.Resources>
            <DataTemplate x:Key="RepositoryCoverTemplate" x:DataType="local:SecondLevelFolderItem">
                <Button Click="OnRepositoryCoverClicked" DoubleTapped="OnSecondLevelDoubleTapped"
                        RightTapped="OnSecondLevelItemRightTapped" Padding="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind Name}"
                        BorderThickness="{x:Bind CoverSelectionThickness, Mode=OneWay}"
                        BorderBrush="{ThemeResource AppNavSelectedBorderBrush}"
                        Background="{ThemeResource AppCardBackgroundBrush}">
                <Grid Margin="4" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource AppCardBorderBrush}"
                      Background="{ThemeResource AppCardBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Bind CoverPreviewHeight, Mode=OneWay}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{ThemeResource AppPreviewBackgroundBrush}" CornerRadius="4">
                        <Image Source="{x:Bind CoverImageSource, Mode=OneWay}" Stretch="Uniform" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9"
                                    Visibility="{x:Bind CoverPlaceholderVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xEB9F;" FontSize="28" Opacity="0.75" />
                            <TextBlock Text="{x:Bind CoverPlaceholder, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Padding="10" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" MaxLines="2"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="1" ColumnSpacing="7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Center" Opacity="0.75" />
                            <TextBlock Grid.Column="1" Text="{x:Bind State, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </Grid>
                </Button>
            </DataTemplate>
        </Grid.Resources>
        <Grid x:Name="AppShellGrid" Padding="12,0,12,12" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The app header is the window title bar; the system draws the caption buttons on the right. -->
            <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Margin="-12,0,-12,0" Padding="16,0,0,0" ColumnSpacing="10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="20" Height="20" Source="Assets/AppIcon.png" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderTitleTextBlock" Grid.Column="1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderVersionBadgeTextBlock" Grid.Column="2" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderSubtitleTextBlock" Visibility="Collapsed" />
                <TextBlock x:Name="HeaderCaptionTextBlock" Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PrimaryNavColumn" Width="68" />
                    <ColumnDefinition x:Name="SecondaryNavColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <Border x:Name="PrimaryNavBorder" Grid.Column="0" Style="{StaticResource NavigationPaneBorderStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <StackPanel Visibility="Collapsed" Spacing="4">
                        <TextBlock x:Name="BetaTitleTextBlock" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="BetaCaptionTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Search opens the Ctrl+K palette; it heads the navigation like the search box of Windows Settings. -->
                    <Button x:Name="NavSearchButton" Click="OnNavSearchClicked" Style="{StaticResource NavigationIconButtonStyle}" />
                    <Border x:Name="NavSearchDivider" Height="1" Margin="10,2" Background="{ThemeResource AppCardBorderBrush}" />
                    <Button x:Name="DashboardNavButton" Click="OnDashboardNavClicked" Style="{StaticResource NavigationIconButtonStyle}" />
                    <Button x:Name="RepositoryNavButton" Click="OnRepositoryNavClicked" Style="{StaticResource NavigationIconButtonStyle}" />
                    <Button x:Name="OnlineNavButton" Click="OnOnlineNavClicked" Style="{StaticResource NavigationIconButtonStyle}" />
                    <Button x:Name="UpdatesNavButton" Click="OnUpdatesNavClicked" Style="{StaticResource NavigationIconButtonStyle}" />
                    <Button x:Name="ShortcutsNavButton" Click="OnShortcutsNavClicked" Style="{StaticResource NavigationIconButtonStyle}" />
                </StackPanel>
                    <!-- Downloads sit at the foot of the navigation, above Settings: the count and bar follow
                         running downloads, and the flyout opens to the right with every task. -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="6">
                    <Button x:Name="NavTasksButton" Style="{StaticResource NavigationIconButtonStyle}">
                        <Grid x:Name="NavTasksContent" ColumnSpacing="12" RowSpacing="5">
                            <Grid x:Name="NavTasksIconHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="16" Opacity="0.88" />
                                <Border x:Name="NavTasksBadge" Margin="0,-8,-14,0" Padding="5,0" MinWidth="16" CornerRadius="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource AppAccentBrush}" Visibility="Collapsed">
                                    <TextBlock x:Name="NavTasksCountTextBlock" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="NavTasksLabelTextBlock" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <ProgressBar x:Name="NavTasksProgressBar" Height="3" MinHeight="3" Minimum="0" Maximum="100" Visibility="Collapsed" />
                        </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="NavTasksFlyout" Placement="RightEdgeAlignedBottom"
                                Opening="OnNavTasksFlyoutOpening" Closed="OnNavTasksFlyoutClosed">
                            <Grid Width="380" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NavTasksTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                    <Button x:Name="NavTasksClearButton" Grid.Column="1" Click="OnClearDownloadTasksClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="NavTasksAllButton" Grid.Column="2" Click="OnNavTasksAllClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="NavTasksPanel" Spacing="8" />
                                </ScrollViewer>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                    </Button>
                    <Button x:Name="NavCollapseButton" Opacity="0.8"
                            Click="OnNavCollapseClicked" Style="{StaticResource NavigationIconButtonStyle}" />
                    </StackPanel>
                    <Button x:Name="SettingsNavButton" Grid.Row="2" Click="OnSettingsNavClicked" Style="{StaticResource NavigationIconButtonStyle}" />
                </Grid>
            </Border>

            <Border x:Name="SecondaryNavBorder" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14" Visibility="Collapsed">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SecondaryNavTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SecondaryNavHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SecondaryNavPanel" Spacing="8" />
                    </ScrollViewer>

                </Grid>
            </Border>

            <Grid x:Name="PagesHostGrid" Grid.Column="2">
                <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="DashboardRootPanel" Margin="2,2,8,20" Spacing="12">
                        <local:PageHeader x:Name="DashboardPageHeader">
                            <local:PageHeader.Actions>
                                <!-- New repository: blank, or from a game preset. Presets no longer take a card on the page. -->
                                <DropDownButton x:Name="AddRepositoryButton" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        <TextBlock x:Name="DashboardAddRepositoryTextBlock" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="NewRepositoryMenu" Placement="BottomEdgeAlignedRight" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </local:PageHeader.Actions>
                        </local:PageHeader>

                        <!-- The current repository in one strip: picker, status, counts and its actions. -->
                        <Border x:Name="DashboardRepositorySelectorCard" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                            <Grid x:Name="DashboardStripGrid" ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource AppSecondarySelectedBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AppSecondarySelectedForegroundBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="DashboardCurrentRepositoryLabelTextBlock" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox
                                        x:Name="DashboardRepositoryComboBox"
                                        MinWidth="220"
                                        MaxWidth="560"
                                        HorizontalAlignment="Left"
                                        SelectionChanged="OnDashboardRepositorySelectionChanged" />
                                </StackPanel>
                                <StackPanel x:Name="DashboardStripStatus" Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <Grid HorizontalAlignment="Left">
                                        <Border Background="{ThemeResource AppSuccessSoftBrush}" CornerRadius="6" Padding="10,3" Visibility="{x:Bind Dashboard.CurrentIsReady, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Dashboard.CurrentStatusText, Mode=OneWay}" Foreground="{ThemeResource AppSuccessBrush}" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="{ThemeResource AppDangerSoftBrush}" CornerRadius="6" Padding="10,3" Visibility="{x:Bind Dashboard.CurrentNeedsSetup, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Dashboard.CurrentStatusText, Mode=OneWay}" Foreground="{ThemeResource AppDangerBrush}" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Dashboard.CurrentSummary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="DashboardStripActions" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="RenameRepositoryButton" Click="OnEditRepositoryDetailsClicked" Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                            <TextBlock x:Name="DashboardEditRepositoryTextBlock" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DashboardOpenRepositoryButton" Click="OnDashboardOpenRepositoryClicked" Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="DashboardMainGrid" ColumnSpacing="12" RowSpacing="12">
                            <!-- Left: paths, then the character overview filling the rest of the page. -->
                            <Grid x:Name="DashboardLeftColumn" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- The path boxes are the window's existing path controls, moved here at startup. -->
                            <Border x:Name="DashboardPathsCard" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="DashboardPathsTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock x:Name="DashboardPathsHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ContentControl x:Name="DashboardPathsHost" HorizontalContentAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="DashboardCharactersCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="DashboardCharactersTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock x:Name="DashboardCharactersHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind Dashboard.CharactersEmptyText, Mode=OneWay}"
                                        Style="{StaticResource MutedTextStyle}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind Dashboard.HasCharactersEmptyText, Mode=OneWay}" />
                                    <GridView
                                        x:Name="DashboardCharactersGridView"
                                        Grid.Row="1"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnDashboardCharacterClicked"
                                        ItemsSource="{x:Bind Dashboard.Characters}"
                                        SelectionMode="None">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="60" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:CharacterChipViewModel">
                                                <Grid Width="186" Height="52" Padding="8,6" ColumnSpacing="10" CornerRadius="10" Background="{ThemeResource AppInsetBackgroundBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AppSecondarySelectedBrush}" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="{x:Bind Initial}" Foreground="{ThemeResource AppSecondarySelectedForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Ellipse Width="36" Height="36" Visibility="{x:Bind HasAvatar, Mode=OneWay}">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </Grid>
                            </Border>
                            </Grid>

                            <!-- Right: every repository, then the actions people reach for most. -->
                            <Grid x:Name="DashboardRightColumn" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="DashboardRepositoriesCard" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="DashboardRepositoriesTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock x:Name="DashboardRepositoriesHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ItemsRepeater x:Name="DashboardRepositoriesRepeater" ItemsSource="{x:Bind Dashboard.Repositories}">
                                        <ItemsRepeater.Layout>
                                            <!-- UniformGridLayout divides by zero when measured narrower than one item while the page re-lays out. -->
                                            <StackLayout Spacing="10" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="local:RepositoryCardViewModel">
                                                <Grid>
                                                    <Border Style="{StaticResource InsetBorderStyle}" Padding="14,12">
                                                        <Grid RowSpacing="8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Grid Grid.Column="1" VerticalAlignment="Top">
                                                                    <Border Background="{ThemeResource AppSuccessSoftBrush}" CornerRadius="6" Padding="8,2" Visibility="{x:Bind IsReady, Mode=OneWay}">
                                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{ThemeResource AppSuccessBrush}" Style="{StaticResource CaptionTextStyle}" />
                                                                    </Border>
                                                                    <Border Background="{ThemeResource AppDangerSoftBrush}" CornerRadius="6" Padding="8,2" Visibility="{x:Bind NeedsSetup, Mode=OneWay}">
                                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{ThemeResource AppDangerBrush}" Style="{StaticResource CaptionTextStyle}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                            <TextBlock Grid.Row="1" Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                                            <Grid Grid.Row="2" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button
                                                                    HorizontalAlignment="Stretch"
                                                                    Command="{x:Bind SwitchToCommand}"
                                                                    Content="{x:Bind Labels.SwitchTo, Mode=OneWay}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Visibility="{x:Bind IsOther, Mode=OneWay}" />
                                                                <TextBlock
                                                                    Text="{x:Bind Labels.Current, Mode=OneWay}"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource AppAccentBrush}"
                                                                    FontWeight="SemiBold"
                                                                    Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                                                <Button Grid.Column="1" Command="{x:Bind ManageCommand}" Content="{x:Bind Labels.Manage, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}" />
                                                                <Button
                                                                    Grid.Column="2"
                                                                    Width="40"
                                                                    Padding="0"
                                                                    AutomationProperties.Name="{x:Bind Labels.More, Mode=OneWay}"
                                                                    ToolTipService.ToolTip="{x:Bind Labels.More, Mode=OneWay}"
                                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                                    <Button.Flyout>
                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                            <MenuFlyoutItem Text="{x:Bind Labels.Edit, Mode=OneWay}" Command="{x:Bind EditCommand}">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutItem Text="{x:Bind Labels.OpenWiki, Mode=OneWay}" Command="{x:Bind OpenWikiCommand}">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutSeparator />
                                                                            <MenuFlyoutItem Text="{x:Bind Labels.Delete, Mode=OneWay}" Command="{x:Bind DeleteCommand}">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <!-- The current repository is outlined in the accent colour. -->
                                                    <Border
                                                        BorderBrush="{ThemeResource AppNavSelectedBorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="10"
                                                        IsHitTestVisible="False"
                                                        Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DashboardQuickActionsCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="DashboardQuickActionsTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DashboardBrowseOnlineButton" HorizontalAlignment="Stretch" Click="OnDashboardBrowseOnlineClicked" Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE774;" FontSize="14" />
                                                <TextBlock x:Name="DashboardBrowseOnlineTextBlock" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DashboardCheckUpdatesButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnDashboardCheckUpdatesClicked" Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                                <TextBlock x:Name="DashboardCheckUpdatesTextBlock" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DashboardRunLauncherButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnRunLauncherClicked" Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                <TextBlock x:Name="DashboardRunLauncherTextBlock" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="WorkspaceScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,2,8,16" Spacing="16">
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="PathSectionTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="PathSectionSubtitleTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SourceLabelTextBlock" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource InsetBorderStyle}">
                                <TextBox x:Name="SourceTextBox" Padding="12,8" BorderThickness="0" />
                            </Border>
                            <Button x:Name="PickSourceButton" Grid.Column="2" Click="OnPickSourceClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="OpenSourceButton" Grid.Column="3" Click="OnOpenSourceClicked" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TargetLabelTextBlock" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource InsetBorderStyle}">
                                <TextBox x:Name="TargetTextBox" Padding="12,8" BorderThickness="0" />
                            </Border>
                            <Button x:Name="PickTargetButton" Grid.Column="2" Click="OnPickTargetClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="OpenTargetButton" Grid.Column="3" Click="OnOpenTargetClicked" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LauncherLabelTextBlock" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource InsetBorderStyle}">
                                <TextBox x:Name="LauncherTextBox" Padding="12,8" BorderThickness="0" />
                            </Border>
                            <Button x:Name="PickLauncherButton" Grid.Column="2" Click="OnPickLauncherClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="OpenLauncherButton" Grid.Column="3" Click="OnOpenLauncherClicked" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Button x:Name="BridgeOptionsButton" Grid.Row="4" Click="OnBridgeOptionsClicked"
                                Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="10,6" Style="{StaticResource SecondaryButtonStyle}" />

                        <Border Grid.Row="5" Padding="14,10" Style="{StaticResource InsetBorderStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    x:Name="LinkDeploymentToggleSwitch"
                                    VerticalAlignment="Center"
                                    Toggled="OnLinkDeploymentToggled" />
                                <TextBlock
                                    x:Name="PathHintTextBlock"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MutedTextStyle}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <ProgressBar x:Name="CopyProgressBar" Minimum="0" Maximum="100" Height="8" />
                                <TextBlock x:Name="ProgressTextBlock" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Button x:Name="RefreshButton" Grid.Column="1" Click="OnRefreshClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="ImportZipButton" Grid.Column="2" Click="OnImportZipClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="RunLauncherButton" Grid.Column="3" Click="OnRunLauncherClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="ToggleCopyButton" Grid.Column="4" Click="OnToggleCopyClicked" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>

                        <Grid x:Name="RepositoryMetricsGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" MinWidth="220" />
                                <ColumnDefinition Width="1.1*" MinWidth="220" />
                                <ColumnDefinition Width="1.15*" MinWidth="240" />
                                <ColumnDefinition Width="1.05*" MinWidth="220" />
                            </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="FirstCountLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="FirstCountTextBlock" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                            <TextBlock x:Name="FirstCountHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SecondCountLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="SecondCountTextBlock" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                            <TextBlock x:Name="SecondCountHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="CurrentStateLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="CurrentStateTextBlock" Style="{StaticResource MetricValueTextStyle}" />
                            <TextBlock x:Name="CurrentStateHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="CurrentFolderLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="CurrentFolderTextBlock" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="CurrentFolderHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="RepositoryPanelsGrid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" MinWidth="280" />
                        <ColumnDefinition Width="1.1*" MinWidth="320" />
                        <ColumnDefinition Width="1.15*" MinWidth="300" />
                        <ColumnDefinition Width="1.05*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FirstLevelSectionTitleTextBlock" VerticalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" />
                                <Button
                                    x:Name="CreateFirstLevelButton"
                                    Grid.Column="1"
                                    Width="42"
                                    Height="42"
                                    Padding="0"
                                    Click="OnCreateFirstLevelClicked"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                                </Button>
                                <Button
                                    x:Name="RenameFirstLevelButton"
                                    Grid.Column="2"
                                    Width="42"
                                    Height="42"
                                    Padding="0"
                                    Click="OnRenameFirstLevelClicked"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                </Button>
                                <Button
                                    x:Name="CharacterAvatarButton"
                                    Grid.Column="3"
                                    Width="42"
                                    Height="42"
                                    Padding="0"
                                    Click="OnCharacterAvatarButtonClicked"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE77B;" />
                                </Button>
                                <ToggleButton
                                    x:Name="CharacterMultipleModsToggle"
                                    Grid.Column="4"
                                    Width="42"
                                    Height="42"
                                    Padding="0"
                                    Click="OnCharacterMultipleModsToggleClicked">
                                    <FontIcon FontSize="16" Glyph="&#xE8B3;" />
                                </ToggleButton>
                            </Grid>
                            <TextBlock x:Name="FirstLevelSectionSubtitleTextBlock" Grid.Row="1" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <Border Grid.Row="2" Style="{StaticResource InsetBorderStyle}">
                                <TextBox
                                    x:Name="FirstLevelSearchTextBox"
                                    Padding="12,8"
                                    BorderThickness="0"
                                    TextChanged="OnFirstLevelSearchTextChanged" />
                            </Border>
                            <Border Grid.Row="3" Style="{StaticResource InsetBorderStyle}">
                                <ListView x:Name="FirstLevelListView" SingleSelectionFollowsFocus="False" SelectionChanged="OnFirstLevelSelectionChanged" Style="{StaticResource AppListViewStyle}" ItemContainerStyle="{StaticResource CompactListViewItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:FirstLevelFolderItem">
                                            <Grid Padding="4,8" ColumnSpacing="8" RightTapped="OnFirstLevelItemRightTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="28" Height="28">
                                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind AvatarInitial}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" Visibility="{x:Bind AvatarPlaceholderVisibility, Mode=OneWay}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind AvatarImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="12" Text="{x:Bind ChildrenCount}" VerticalAlignment="Center" Opacity="0.75" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SecondLevelSectionTitleTextBlock" VerticalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" />
                                <Button
                                    x:Name="DeleteSecondLevelButton"
                                    Grid.Column="1"
                                    Width="42"
                                    Height="42"
                                    Padding="0"
                                    Click="OnDeleteSecondLevelClicked"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="SecondLevelSectionSubtitleTextBlock" Grid.Row="1" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <Border
                                x:Name="SecondLevelDropBorder"
                                Grid.Row="2"
                                AllowDrop="True"
                                Style="{StaticResource InsetBorderStyle}"
                                DragOver="OnSecondLevelDragOver"
                                DragLeave="OnDropTargetDragLeave"
                                Drop="OnSecondLevelDrop">
                                <ListView x:Name="SecondLevelListView" SingleSelectionFollowsFocus="False" SelectionChanged="OnSecondLevelSelectionChanged" DoubleTapped="OnSecondLevelDoubleTapped" Style="{StaticResource AppListViewStyle}" ItemContainerStyle="{StaticResource AppListViewItemStyle}">
                                    <ListView.ItemTemplate>
                                        <!-- A row: cover thumbnail, name with its tag chips and shortcut count, size, and the state as a pill. -->
                                        <DataTemplate x:DataType="local:SecondLevelFolderItem">
                                            <Grid Padding="6,6" ColumnSpacing="10" RightTapped="OnSecondLevelItemRightTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="40" Height="40" CornerRadius="6" Background="{ThemeResource AppPreviewBackgroundBrush}">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Opacity="0.6" Visibility="{x:Bind CoverPlaceholderVisibility, Mode=OneWay}" />
                                                    <Image Source="{x:Bind CoverImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind DetailLineVisibility, Mode=OneWay}">
                                                        <ItemsRepeater ItemsSource="{x:Bind Tags, Mode=OneWay}">
                                                            <ItemsRepeater.Layout>
                                                                <StackLayout Orientation="Horizontal" Spacing="4" />
                                                            </ItemsRepeater.Layout>
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border Padding="6,0,6,1" CornerRadius="4" Background="{ThemeResource AppSecondaryDefaultBrush}">
                                                                        <TextBlock FontSize="12" Opacity="0.85" Text="{x:Bind}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind KeysText, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    MinWidth="64"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    Text="{x:Bind SizeText, Mode=OneWay}"
                                                    TextAlignment="Right"
                                                    VerticalAlignment="Center" />
                                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                                    <Border Padding="8,2" CornerRadius="4" Background="{ThemeResource AppSuccessSoftBrush}" Visibility="{x:Bind DeployedPillVisibility, Mode=OneWay}">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource AppSuccessBrush}" Text="{x:Bind State, Mode=OneWay}" />
                                                    </Border>
                                                    <Border Padding="8,2" CornerRadius="4" Background="{ThemeResource AppSecondaryDefaultBrush}" Visibility="{x:Bind IdlePillVisibility, Mode=OneWay}">
                                                        <TextBlock FontSize="12" Opacity="0.8" Text="{x:Bind State, Mode=OneWay}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ShortcutSectionTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ShortcutSectionSubtitleTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ShortcutRowsTextBlock" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <Button x:Name="AddShortcutRowButton" Grid.Column="1" Click="OnAddShortcutRowClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ShortcutRowsPanel" Spacing="10" />
                            </ScrollViewer>
                            <TextBlock
                                x:Name="ShortcutHintTextBlock"
                                Grid.Row="3"
                                Margin="0,4,0,2"
                                Style="{StaticResource MutedTextStyle}"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PreviewSectionTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="PreviewSectionSubtitleTextBlock" Grid.Row="1" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <Border
                                x:Name="PreviewDropBorder"
                                Grid.Row="2"
                                Height="320"
                                AllowDrop="True"
                                Style="{StaticResource InsetBorderStyle}"
                                Background="{ThemeResource AppPreviewBackgroundBrush}"
                                DragOver="OnPreviewDragOver"
                                DragLeave="OnDropTargetDragLeave"
                                Drop="OnPreviewDrop">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ImageOpened="OnPreviewImageOpened" Tapped="OnPreviewImageTapped" />
                                    <TextBlock
                                        x:Name="PreviewHintTextBlock"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="18"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="3" Spacing="6">
                                <TextBlock x:Name="ModLinkSectionTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="ModLinkSectionSubtitleTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Row="4" Style="{StaticResource InsetBorderStyle}">
                                <TextBox
                                    x:Name="ModLinkTextBox"
                                    Padding="12,8"
                                    BorderThickness="0"
                                    TextChanged="OnModLinkTextChanged" />
                            </Border>

                            <Grid Grid.Row="5" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PreviewFooterTextBlock" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                <Button
                                    x:Name="OpenModLinkButton"
                                    Grid.Column="1"
                                    Click="OnOpenModLinkClicked"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="PersistentSlotsCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="PersistentSlotTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="PersistentSlotHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PersistentUserIniTextBox" PlaceholderText="d3dx_user.ini" />
                            <Button x:Name="BrowsePersistentUserIniButton" Grid.Column="1" Click="OnBrowsePersistentUserIniClicked" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <ComboBox x:Name="PersistentSlotComboBox" SelectionChanged="OnPersistentSlotSelectionChanged" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="PersistentSlotValuesTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CapturePersistentSlotButton" Click="OnCapturePersistentSlotClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="DeletePersistentSlotButton" Grid.Column="1" Click="OnDeletePersistentSlotClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <Button x:Name="RestorePersistentRuntimeButton" Click="OnRestorePersistentRuntimeClicked" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButtonStyle}" />
                        <DropDownButton x:Name="PersistentSlotMoreButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button x:Name="OpenCombinationPresetsButton" Click="OnOpenCombinationPresetsClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock x:Name="PersistentSlotStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="WorkspaceStatusCard" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AuthorTextBlock" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
                </ScrollViewer>

                <Grid x:Name="OnlineScrollViewer" Visibility="Collapsed" Margin="6">
                    <!-- One card: header row, then character rail beside the results. Details open in a
                         drawer floating over the right side, so the page never shrinks while it is open. -->
                    <Grid x:Name="OnlineDetailsHost" SizeChanged="OnOnlineDetailsHostSizeChanged">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="16,12,16,12">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="OnlineTitleTextBlock" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <!-- The page descriptions live in this tooltip instead of two header lines. -->
                                            <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.7" VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="420">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock x:Name="OnlinePreviewTitleTextBlock" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="OnlinePreviewHintTextBlock" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="OnlineSubtitleTextBlock" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border
                                                Background="{ThemeResource AppAccentSoftBrush}"
                                                CornerRadius="6"
                                                Padding="10,4">
                                                <TextBlock
                                                    x:Name="OnlineStatusTextBlock"
                                                    MaxLines="1"
                                                    MaxWidth="460"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Border>
                                            <Border
                                                x:Name="OnlineCacheStatusBorder"
                                                Background="{ThemeResource AppInsetBackgroundBrush}"
                                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                Visibility="Collapsed">
                                                <TextBlock
                                                    x:Name="OnlineCacheStatusTextBlock"
                                                    MaxLines="1"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" x:Name="OnlineDownloadProgressPanel" Width="240" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="OnlineDownloadProgressTextBlock" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar x:Name="OnlineDownloadProgressBar" Minimum="0" Maximum="100" Height="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2" Padding="2" CornerRadius="8" Background="{ThemeResource AppInsetBackgroundBrush}">
                                                <Button
                                                    x:Name="OnlineListLayoutButton"
                                                    Width="36"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnOnlineListLayoutClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="15" Glyph="&#xEA37;" />
                                                </Button>
                                                <Button
                                                    x:Name="OnlineGridLayoutButton"
                                                    Width="36"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnOnlineGridLayoutClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="15" Glyph="&#xECA5;" />
                                                </Button>
                                            </StackPanel>
                                            <Button
                                                x:Name="RefreshOnlineButton"
                                                Click="OnRefreshOnlineModsClicked"
                                                MinHeight="36"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        x:Name="OnlineWorkspaceGrid"
                                        Grid.Row="1"
                                        HorizontalAlignment="Stretch"
                                        ColumnSpacing="12"
                                        RowSpacing="12"
                                        SizeChanged="OnOnlineWorkspaceGridSizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="OnlineCharacterRailColumn" Width="188" />
                                            <ColumnDefinition x:Name="OnlineResultsColumn" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition x:Name="OnlineCharacterRailRow" Height="*" />
                                            <RowDefinition x:Name="OnlineResultsRow" Height="0" />
                                        </Grid.RowDefinitions>

                                        <Border x:Name="OnlineCharacterRailHost" Grid.Column="0" Style="{StaticResource InsetBorderStyle}" Padding="10">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    x:Name="OnlineCharacterRailTitleTextBlock"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    TextAlignment="Left"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <ScrollViewer
                                                    x:Name="OnlineCharacterRailScrollViewer"
                                                    Grid.Row="1"
                                                    Padding="0,0,2,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    HorizontalScrollMode="Disabled"
                                                    VerticalContentAlignment="Stretch"
                                                    VerticalScrollBarVisibility="Auto"
                                                    VerticalScrollMode="Enabled">
                                                    <StackPanel
                                                        x:Name="OnlineCharacterAvatarPanel"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,0,10,0"
                                                        Orientation="Vertical"
                                                        Spacing="6" />
                                                </ScrollViewer>
                                                <TextBlock
                                                    x:Name="OnlineCharacterRailHintTextBlock"
                                                    Grid.Row="2"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                        </Border>

                                        <Grid
                                            x:Name="OnlineResultsHost"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            MinWidth="0"
                                            RowSpacing="8"
                                            SizeChanged="OnOnlineResultsHostSizeChanged">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- One toolbar row: search, sort, then the page filters and options. -->
                                            <Grid ColumnSpacing="8" Canvas.ZIndex="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="176" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="OnlineSearchTextBox"
                                                    MinHeight="36"
                                                    Padding="12,7"
                                                    PlaceholderText="Search this page: character, mod or author"
                                                    TextChanged="OnOnlineSearchTextChanged" />
                                                <ComboBox
                                                    x:Name="OnlineCharacterComboBox"
                                                    Visibility="Collapsed"
                                                    MinHeight="36"
                                                    HorizontalAlignment="Stretch"
                                                    SelectionChanged="OnOnlineCharacterSelectionChanged" />
                                                <ComboBox
                                                    x:Name="OnlineSortComboBox"
                                                    Grid.Column="1"
                                                    MinHeight="36"
                                                    HorizontalAlignment="Stretch"
                                                    SelectionChanged="OnOnlineSortSelectionChanged" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                    <Button x:Name="OnlineWorkFilterButton" MinHeight="36" Padding="10,2" Click="OnOnlineWorkFilterClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button x:Name="ClearOnlineFiltersButton" MinHeight="36" Padding="10,2" Click="OnClearOnlineFiltersClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button x:Name="OnlineSavedItemsButton" Width="36" Height="36" Padding="0" Click="OnOnlineSavedItemsClicked" Style="{StaticResource SecondaryButtonStyle}"><FontIcon FontSize="14" Glyph="&#xE734;" /></Button>
                                                    <Button x:Name="OnlineDownloadOptionsButton" Width="36" Height="36" Padding="0" Click="OnOnlineDownloadOptionsClicked" Style="{StaticResource SecondaryButtonStyle}"><FontIcon FontSize="14" Glyph="&#xE713;" /></Button>
                                                </StackPanel>
                                            </Grid>
                                            <ListView
                                                x:Name="OnlineVirtualizedListView"
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                MinHeight="0"
                                                Canvas.ZIndex="0"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnOnlineResultItemClick"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.HorizontalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Enabled"
                                                SelectionMode="None">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Margin" Value="0,0,12,7" />
                                                        <Setter Property="Padding" Value="0" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl
                                                            HorizontalContentAlignment="Stretch"
                                                            Tag="OnlineListCardPresenter"
                                                            DataContextChanged="OnOnlineListCardPresenterDataContextChanged" />
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                                <ListView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsStackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </ListView.ItemsPanel>
                                            </ListView>
                                            <!-- Item size comes from OnlineLayoutPolicy.GridTiles; clicking a tile (or Enter) opens its details. -->
                                            <GridView
                                                x:Name="OnlineVirtualizedGridView"
                                                SizeChanged="OnOnlineGridSizeChanged"
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                MinHeight="0"
                                                Canvas.ZIndex="0"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnOnlineResultItemClick"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.HorizontalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Enabled"
                                                SelectionMode="None"
                                                Visibility="Collapsed">
                                                <GridView.ItemContainerStyle>
                                                    <Style TargetType="GridViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Padding" Value="0" />
                                                    </Style>
                                                </GridView.ItemContainerStyle>
                                                <GridView.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            IsTabStop="False"
                                                            Tag="OnlineGridCardPresenter"
                                                            DataContextChanged="OnOnlineGridCardPresenterDataContextChanged" />
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                                <GridView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid ItemWidth="300" ItemHeight="307" Orientation="Horizontal" Loaded="OnOnlineGridPanelLoaded" />
                                                    </ItemsPanelTemplate>
                                                </GridView.ItemsPanel>
                                            </GridView>
                                            <ContentControl
                                                x:Name="OnlineEmptyResultsContentControl"
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Top"
                                                Margin="0,0,12,0"
                                                Visibility="Collapsed" />
                                            <Border
                                                x:Name="OnlineLoadingOverlay"
                                                Grid.Row="1"
                                                Background="{ThemeResource AppCardBackgroundBrush}"
                                                CornerRadius="12"
                                                Visibility="Collapsed">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                                    <ProgressRing Width="36" Height="36" IsActive="True" />
                                                    <TextBlock x:Name="OnlineLoadingTextBlock" Style="{StaticResource MutedTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                                    <StackPanel Width="260" Spacing="8" Opacity="0.55">
                                                        <Border Height="10" CornerRadius="5" Background="{ThemeResource AppAccentSoftBrush}" />
                                                        <Border Height="10" Width="210" HorizontalAlignment="Left" CornerRadius="5" Background="{ThemeResource AppAccentSoftBrush}" />
                                                        <Border Height="10" Width="235" HorizontalAlignment="Left" CornerRadius="5" Background="{ThemeResource AppAccentSoftBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                        <Grid
                            x:Name="OnlineDetailDrawer"
                            Grid.Row="1"
                            Width="600"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Canvas.ZIndex="10">
                            <!-- A soft edge shadow separates the drawer from the cards underneath. -->
                            <Border Width="24" Margin="-24,12,0,12" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#38000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="OnlineDetailPaneBorder" Style="{StaticResource DetailPaneBorderStyle}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource InsetBorderStyle}" Padding="14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="OnlineDetailPaneTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="Wrap" />
                                                <!-- Step through the Mods shown on this page without closing the drawer. -->
                                                <Button
                                                    x:Name="OnlineDetailPreviousButton"
                                                    Grid.Column="1"
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    Click="OnOnlineDetailPreviousClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                                                </Button>
                                                <Button
                                                    x:Name="OnlineDetailNextButton"
                                                    Grid.Column="2"
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    Click="OnOnlineDetailNextClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                                                </Button>
                                                <Button
                                                    x:Name="CloseOnlineDetailButton"
                                                    Grid.Column="3"
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    Click="OnCloseOnlineDetailsClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                                </Button>
                                            </Grid>

                                            <TextBlock x:Name="OnlineDetailPaneMetaTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="OnlineDetailPaneStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,14,0" Spacing="12">
                                            <Border x:Name="OnlineDetailHeroBorder" Background="{ThemeResource AppPreviewBackgroundBrush}" CornerRadius="12" Height="360">
                                                <Grid>
                                                    <Image x:Name="OnlineDetailHeroImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed" ImageOpened="OnOnlineDetailHeroImageOpened" Tapped="OnOnlineDetailHeroImageTapped" />
                                                    <TextBlock
                                                        x:Name="OnlineDetailHeroPlaceholderTextBlock"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        Style="{StaticResource CaptionTextStyle}" />
                                                </Grid>
                                            </Border>

                                            <ScrollViewer x:Name="OnlineDetailThumbnailScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                                <StackPanel x:Name="OnlineDetailThumbnailPanel" Margin="0,0,0,12" Orientation="Horizontal" Spacing="8" />
                                            </ScrollViewer>

                                            <Border x:Name="OnlineDetailRequirementBorder" Style="{StaticResource InsetBorderStyle}" Visibility="Collapsed">
                                                <StackPanel Spacing="6">
                                                    <TextBlock x:Name="OnlineDetailRequirementTitleTextBlock" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="OnlineDetailRequirementTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock x:Name="OnlineDetailSummaryTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="OnlineDetailTranslationNoteTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                                            <TextBlock x:Name="OnlineDetailDescriptionTextBlock" TextWrapping="Wrap" />

                                            <Border Style="{StaticResource InsetBorderStyle}" Padding="12">
                                                <TextBlock x:Name="OnlineDetailDownloadHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Row="2" Style="{StaticResource StickyActionBorderStyle}">
                                        <StackPanel Spacing="9">
                                            <TextBlock
                                                x:Name="OnlineDetailDownloadSelectionTextBlock"
                                                Style="{StaticResource CaptionTextStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    x:Name="OpenOnlineDetailPageButton"
                                                    Click="OnOpenOnlineDetailPageClicked"
                                                    HorizontalAlignment="Stretch"
                                                    MinHeight="40"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button
                                                    x:Name="SelectOnlineDetailDownloadButton"
                                                    Grid.Column="1"
                                                    Click="OnSelectOnlineDetailDownloadClicked"
                                                    HorizontalAlignment="Stretch"
                                                    MinHeight="40"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>
                                            <Button
                                                x:Name="DownloadOnlineDetailButton"
                                                Click="OnDownloadOnlineDetailClicked"
                                                HorizontalAlignment="Stretch"
                                                MinHeight="42"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                                            <!-- Footer: what this page shows, then paging. -->
                                            <Grid Grid.Row="2" ColumnSpacing="8" Canvas.ZIndex="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="OnlineFilterSummaryTextBlock" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextStyle}" />
                                                <Button
                                                    x:Name="OnlinePrevPageButton"
                                                    Grid.Column="1"
                                                    Click="OnOnlinePrevPageClicked"
                                                    MinHeight="32"
                                                    MinWidth="84"
                                                    Padding="12,4"
                                                    HorizontalContentAlignment="Center"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBlock
                                                    x:Name="OnlinePaginationTextBlock"
                                                    Grid.Column="2"
                                                    Margin="6,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextStyle}" />
                                                <Button
                                                    x:Name="OnlineNextPageButton"
                                                    Grid.Column="3"
                                                    Click="OnOnlineNextPageClicked"
                                                    MinHeight="32"
                                                    MinWidth="84"
                                                    Padding="12,4"
                                                    HorizontalContentAlignment="Center"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="ShortcutsScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="ShortcutPaneContent" Margin="16" Spacing="14" />
                </ScrollViewer>
                <ScrollViewer x:Name="UpdatesScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="6" Spacing="16">
                        <local:PageHeader x:Name="UpdatesPageHeader" />

                        <Grid x:Name="UpdatesTopGrid" ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="UpdatesPrimaryColumn" Width="1.35*" />
                                <ColumnDefinition x:Name="UpdatesSecondaryColumn" Width="0.85*" />
                                <ColumnDefinition x:Name="UpdatesTertiaryColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="UpdatesMainPanel" Grid.Column="0" Spacing="16">
                                <Border x:Name="UpdatesTrackedModsCard" Style="{StaticResource CardBorderStyle}">
                                    <!-- Header, settings and filters stay put; only the list scrolls, so many Mods never stretch the page. -->
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="10">
                                            <FontIcon Glyph="&#xE895;" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="TrackedModsTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock x:Name="TrackedModsSummaryTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            x:Name="CheckModUpdatesButton"
                                            Grid.Column="2"
                                            Click="OnCheckModUpdatesClicked"
                                            MinHeight="42"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource InsetBorderStyle}" Padding="12,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TrackedModSettingsTitleTextBlock" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ModUpdateStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                <!-- The longer explanations live in the interval box's tooltip. -->
                                                <TextBlock x:Name="TrackedModSettingsHintTextBlock" Visibility="Collapsed" />
                                                <TextBlock x:Name="ModUpdateIntervalHintTextBlock" Visibility="Collapsed" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="ModUpdateIntervalLabelTextBlock" Style="{StaticResource CaptionTextStyle}" />
                                                <ComboBox
                                                    x:Name="ModUpdateIntervalComboBox"
                                                    MinHeight="36"
                                                    HorizontalAlignment="Stretch"
                                                    SelectionChanged="OnModUpdateIntervalSelectionChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="TrackedModsFilterPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                                        <TextBox x:Name="TrackedModsSearchBox" Grid.Column="1" MinWidth="0" TextChanged="OnTrackedModsSearchChanged" />
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <ScrollViewer
                                            x:Name="TrackedModsListScroll"
                                            HorizontalScrollBarVisibility="Disabled"
                                            HorizontalScrollMode="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsRepeater x:Name="TrackedModsRepeater" Margin="0,0,10,0">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="8" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                        <ContentControl x:Name="TrackedModsEmptyHost" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" IsTabStop="False" />
                                    </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- The support column scrolls on its own when the columns fill the window. -->
                            <ScrollViewer
                                x:Name="UpdatesSupportScroll"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="UpdatesSupportPanel" Spacing="16" Margin="0,0,6,0">
                                <!-- On very wide pages this card moves into its own middle column. -->
                                <Border x:Name="UpdatesDownloadsCard" Style="{StaticResource CardBorderStyle}">
                                    <!-- Finished, failed and canceled downloads; the list scrolls inside the card. -->
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5">
                                                <TextBlock x:Name="DownloadTaskCenterTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                                <TextBlock x:Name="DownloadTaskCenterHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="ClearDownloadTasksButton" Grid.Column="1" Click="OnClearDownloadTasksClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                        <StackPanel x:Name="DownloadHistoryFilterPanel" Grid.Row="1" Orientation="Horizontal" Spacing="6" />
                                        <TextBlock x:Name="DownloadHistoryRunningTextBlock" Grid.Row="2" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        <Grid Grid.Row="3">
                                            <ScrollViewer
                                                x:Name="DownloadHistoryListScroll"
                                                HorizontalScrollBarVisibility="Disabled"
                                                HorizontalScrollMode="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsRepeater x:Name="DownloadHistoryRepeater" Margin="0,0,10,0">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="6" />
                                                    </ItemsRepeater.Layout>
                                                </ItemsRepeater>
                                            </ScrollViewer>
                                            <ContentControl x:Name="DownloadHistoryEmptyHost" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" IsTabStop="False" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="UpdatesSafetyCard" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel x:Name="UpdatesSafetyPanel" Spacing="12">
                                        <TextBlock x:Name="InstallSafetyTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock x:Name="InstallSafetyHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="ConflictDetectionToggleSwitch" Toggled="OnConflictDetectionToggled" />
                                        <!-- Recovery actions share one equal-width row (the preset shortcut is added in code). -->
                                        <Grid x:Name="UpdatesRecoveryActionsGrid" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="RollbackLastInstallButton" Click="OnRollbackLastInstallClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                        <TextBlock x:Name="InstallRollbackStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="ConfigurationProfilesTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock x:Name="ConfigurationProfilesHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                        <ComboBox
                                            x:Name="ConfigurationProfileComboBox"
                                            MinHeight="42"
                                            SelectionChanged="OnConfigurationProfileSelectionChanged" />
                                        <CheckBox x:Name="CaptureCombinationStateCheckBox" IsChecked="True" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CombinationUserIniTextBox" IsReadOnly="True" MinWidth="0" />
                                            <Button x:Name="BrowseCombinationUserIniButton" Grid.Column="1" Click="OnBrowsePersistentUserIniClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="CreateConfigurationProfileButton" Click="OnCreateConfigurationProfileClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button x:Name="UpdateConfigurationProfileButton" Grid.Column="1" Click="OnUpdateConfigurationProfileClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button x:Name="ApplyConfigurationProfileButton" Grid.Column="2" Click="OnApplyConfigurationProfileClicked" Style="{StaticResource PrimaryButtonStyle}" />
                                            <Button x:Name="DeleteConfigurationProfileButton" Grid.Column="4" Click="OnDeleteConfigurationProfileClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                        <TextBlock x:Name="ConfigurationProfileSummaryTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="UpdatesBackupCard" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel x:Name="UpdatesBackupPanel" Spacing="12">
                                        <StackPanel Spacing="5">
                                            <TextBlock x:Name="BackupManagerTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock x:Name="BackupManagerHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <!-- Controls get their own row so the description keeps the full card width. -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BackupLimitLabelTextBlock" VerticalAlignment="Center" />
                                            <NumberBox
                                                x:Name="BackupLimitNumberBox"
                                                Grid.Column="1"
                                                Width="110"
                                                Minimum="0.5"
                                                Maximum="100"
                                                SmallChange="0.5"
                                                SpinButtonPlacementMode="Compact"
                                                ValueChanged="OnBackupLimitValueChanged" />
                                            <Button
                                                x:Name="RefreshBackupsButton"
                                                Grid.Column="3"
                                                Click="OnRefreshBackupsClicked"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                        <Expander
                                            x:Name="BackupHistoryExpander"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock x:Name="BackupSummaryTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            </Expander.Header>
                                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="BackupListPanel" Spacing="10" Margin="0,8,0,0" />
                                            </ScrollViewer>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="SettingsScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    Visibility="Collapsed">
                    <StackPanel Margin="6" Spacing="16">
                        <local:PageHeader x:Name="SettingsPageHeader" />

                        <Border x:Name="SettingsAppearanceCard" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="SettingsAppearanceTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                <StackPanel Spacing="8">
                                    <local:SettingRow x:Name="LanguageSettingRow" Glyph="&#xE774;">
                                        <local:SettingRow.Action>
                                            <ComboBox
                                                x:Name="LanguageComboBox"
                                                MinWidth="160"
                                                ItemsSource="{x:Bind AppearanceSettings.LanguageOptions, Mode=OneWay}"
                                                SelectedIndex="{x:Bind AppearanceSettings.LanguageIndex, Mode=TwoWay}" />
                                        </local:SettingRow.Action>
                                    </local:SettingRow>
                                    <local:SettingRow x:Name="ThemeSettingRow" Glyph="&#xE790;">
                                        <local:SettingRow.Action>
                                            <ComboBox
                                                x:Name="ThemeComboBox"
                                                MinWidth="160"
                                                ItemsSource="{x:Bind AppearanceSettings.ThemeOptions, Mode=OneWay}"
                                                SelectedIndex="{x:Bind AppearanceSettings.ThemeIndex, Mode=TwoWay}" />
                                        </local:SettingRow.Action>
                                    </local:SettingRow>
                                    <local:SettingRow x:Name="DensitySettingRow" Glyph="&#xE8A9;">
                                        <local:SettingRow.Action>
                                            <ComboBox
                                                x:Name="DensityComboBox"
                                                MinWidth="160"
                                                ItemsSource="{x:Bind AppearanceSettings.DensityOptions, Mode=OneWay}"
                                                SelectedIndex="{x:Bind AppearanceSettings.DensityIndex, Mode=TwoWay}" />
                                        </local:SettingRow.Action>
                                    </local:SettingRow>
                                    <local:SettingRow x:Name="MotionSettingRow" Glyph="&#xE786;">
                                        <local:SettingRow.Action>
                                            <ToggleSwitch
                                                x:Name="ReduceMotionToggleSwitch"
                                                IsOn="{x:Bind AppearanceSettings.ReduceMotion, Mode=TwoWay}" />
                                        </local:SettingRow.Action>
                                    </local:SettingRow>
                                    <local:SettingRow x:Name="TraySettingRow" Glyph="&#xE8B7;">
                                        <local:SettingRow.Action>
                                            <ToggleSwitch x:Name="MinimizeToTrayToggleSwitch" Toggled="OnMinimizeToTrayToggled" />
                                        </local:SettingRow.Action>
                                    </local:SettingRow>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsAppUpdatesCard" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="SettingsProjectTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="SettingsProjectHintTextBlock" Style="{StaticResource CaptionTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Border Style="{StaticResource SettingRowBorderStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE895;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Name="StartupUpdateTitleTextBlock" FontWeight="SemiBold" />
                                            <TextBlock x:Name="StartupUpdateDescriptionTextBlock" Style="{StaticResource CaptionTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartupUpdateToggleSwitch" Grid.Column="2" VerticalAlignment="Center" Toggled="OnStartupUpdateToggled" />
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="UpdateCheckIntervalLabelTextBlock"
                                        VerticalAlignment="Center" />

                                    <ComboBox
                                        x:Name="UpdateCheckIntervalComboBox"
                                        Grid.Column="1"
                                        MinHeight="42"
                                        SelectionChanged="OnUpdateCheckIntervalSelectionChanged"
                                        PlaceholderText="Select update check interval" />
                                </Grid>
                                <TextBlock x:Name="UpdateCheckIntervalHintTextBlock" Style="{StaticResource CaptionTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Grid x:Name="AppUpdateActionsGrid" ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="AppUpdateActionColumn1" Width="*" />
                                        <ColumnDefinition x:Name="AppUpdateActionColumn2" Width="*" />
                                        <ColumnDefinition x:Name="AppUpdateActionColumn3" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button
                                        x:Name="OpenGitHubButton"
                                        Click="OnOpenGitHubClicked"
                                        MinHeight="42"
                                        Style="{StaticResource SecondaryButtonStyle}" />

                                    <Button
                                        x:Name="CheckUpdatesButton"
                                        Grid.Column="1"
                                        Click="OnCheckUpdatesClicked"
                                        MinHeight="42"
                                        Style="{StaticResource SecondaryButtonStyle}" />

                                    <Button
                                        x:Name="InstallUpdateButton"
                                        Grid.Column="2"
                                        Click="OnInstallUpdateClicked"
                                        MinHeight="42"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                                <TextBlock x:Name="UpdateStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <StackPanel x:Name="AppUpdateProgressPanel" Spacing="6" Visibility="Collapsed">
                                    <TextBlock x:Name="AppUpdateProgressTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="AppUpdateProgressBar" Minimum="0" Maximum="100" Height="8" />
                                </StackPanel>
                                <Border Style="{StaticResource InsetBorderStyle}" Padding="12,10">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="LatestReleaseTitleTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LatestReleaseMetaTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        <ScrollViewer x:Name="UpdateNotesScrollViewer" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="UpdateNotesTextBlock" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsOnlineCard" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="SettingsPlaceholderTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="SettingsPlaceholderTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <!-- One compact table, split into two halves side by side so it stays short. -->
                                <Grid x:Name="SettingsOnlineInfoGrid" ColumnSpacing="24">
                                    <Grid.Resources>
                                        <DataTemplate x:Key="SettingInfoItemTemplate" x:DataType="local:SettingInfoItem">
                                            <Grid ColumnSpacing="12" Padding="0,5" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Value}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl x:Name="SettingsOnlineInfoList" ItemTemplate="{StaticResource SettingInfoItemTemplate}" />
                                    <ItemsControl x:Name="SettingsOnlineInfoList2" Grid.Column="1" ItemTemplate="{StaticResource SettingInfoItemTemplate}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="EditOnlineRepositoryButton"
                                        Click="OnEditRepositoryDetailsClicked"
                                        MinHeight="42"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        x:Name="EditCharacterMappingsButton"
                                        Click="OnEditCharacterMappingsClicked"
                                        MinHeight="42"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsDiagnosticsCard" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="DiagnosticsTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="DiagnosticsHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ExportDiagnosticsButton" Click="OnExportDiagnosticsClicked" MinHeight="42" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="SubmitDiagnosticsButton" Grid.Column="1" Click="OnSubmitDiagnosticsClicked" MinHeight="42" Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                                <TextBlock x:Name="DiagnosticsStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ProjectResourcesCard" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="ProjectResourcesTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="ProjectResourcesHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <Grid x:Name="ProjectResourcesGrid" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button
                                        Tag="https://www.7-zip.org/"
                                        Click="OnExternalResourceClicked"
                                        MinHeight="54"
                                        Padding="12,7"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="7-Zip" FontWeight="SemiBold" />
                                            <TextBlock Text="https://www.7-zip.org/" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="1"
                                        Tag="https://github.com/microsoft/WindowsAppSDK"
                                        Click="OnExternalResourceClicked"
                                        MinHeight="54"
                                        Padding="12,7"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Windows App SDK / WinUI 3" FontWeight="SemiBold" />
                                            <TextBlock Text="https://github.com/microsoft/WindowsAppSDK" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        Tag="https://www.sqlite.org/"
                                        Click="OnExternalResourceClicked"
                                        MinHeight="54"
                                        Padding="12,7"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="SQLite / Microsoft.Data.Sqlite" FontWeight="SemiBold" />
                                            <TextBlock Text="https://www.sqlite.org/" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Row="1"
                                        Tag="https://github.com/libarchive/libarchive"
                                        Click="OnExternalResourceClicked"
                                        MinHeight="54"
                                        Padding="12,7"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="libarchive / Windows tar" FontWeight="SemiBold" />
                                            <TextBlock Text="https://github.com/libarchive/libarchive" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Row="1"
                                        Tag="https://github.com/CommunityToolkit/dotnet"
                                        Click="OnExternalResourceClicked"
                                        MinHeight="54"
                                        Padding="12,7"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="CommunityToolkit.Mvvm" FontWeight="SemiBold" />
                                            <TextBlock Text="https://github.com/CommunityToolkit/dotnet" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Tag="https://github.com/uyujkk/Integrated_Mod_Manager"
                                        Click="OnExternalResourceClicked"
                                        MinHeight="54"
                                        Padding="12,7"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Integrated Mod Manager · GitHub" FontWeight="SemiBold" />
                                            <TextBlock Text="https://github.com/uyujkk/Integrated_Mod_Manager" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Tag="https://space.bilibili.com/476698898"
                                        Click="OnExternalResourceClicked"
                                        MinHeight="54"
                                        Padding="12,7"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="B站主页 / Bilibili" FontWeight="SemiBold" />
                                            <TextBlock Text="https://space.bilibili.com/476698898" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
        <!-- Bottom centre, above the page footers: the corner held paging and Deploy buttons. -->
        <InfoBar
            x:Name="AppInfoBar"
            MaxWidth="520"
            Margin="24,0,24,72"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Window>
