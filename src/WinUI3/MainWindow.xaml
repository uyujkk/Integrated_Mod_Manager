<Window
    x:Class="ModFolderCopier.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Integrated Mod Manager v4.0.0"
    SizeChanged="OnWindowSizeChanged"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppPageBackgroundBrush}" KeyDown="OnRootKeyDown" PointerPressed="OnRootGridPointerPressed">
        <Grid.Resources>
            <DataTemplate x:Key="RepositoryCoverTemplate" x:DataType="local:SecondLevelFolderItem">
                <Button Click="OnRepositoryCoverClicked" DoubleTapped="OnSecondLevelDoubleTapped"
                        RightTapped="OnSecondLevelItemRightTapped" Padding="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind Name}"
                        BorderThickness="{x:Bind CoverSelectionThickness, Mode=OneWay}"
                        BorderBrush="{ThemeResource AppNavSelectedBorderBrush}"
                        Background="{ThemeResource AppCardBackgroundBrush}">
                <Grid Margin="4" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource AppCardBorderBrush}"
                      Background="{ThemeResource AppCardBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Bind CoverPreviewHeight, Mode=OneWay}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{ThemeResource AppPreviewBackgroundBrush}" CornerRadius="4">
                        <Image Source="{x:Bind CoverImageSource, Mode=OneWay}" Stretch="Uniform" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9"
                                    Visibility="{x:Bind CoverPlaceholderVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xEB9F;" FontSize="28" Opacity="0.75" />
                            <TextBlock Text="{x:Bind CoverPlaceholder, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Padding="10" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" MaxLines="2"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="1" ColumnSpacing="7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Center" Opacity="0.75" />
                            <TextBlock Grid.Column="1" Text="{x:Bind State, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </Grid>
                </Button>
            </DataTemplate>
        </Grid.Resources>
        <Grid x:Name="AppShellGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The window title bar (Windows App SDK TitleBar): icon, name, version, and in the middle the
                 search box that opens the Ctrl+K palette, like the search of Windows Settings and Store. -->
            <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.png" />
                </TitleBar.IconSource>
                <AutoSuggestBox x:Name="TitleBarSearchBox" MinWidth="200" MaxWidth="440" VerticalAlignment="Center"
                                QueryIcon="Find" GotFocus="OnTitleBarSearchGotFocus" />
            </TitleBar>

            <!-- Left navigation like Windows Settings: labelled from 1440 px wide (unless the user
                 collapsed it), icons below that. Item names are the old button names, so they keep
                 their automation ids. Downloads opens a flyout instead of a page. -->
            <NavigationView
                x:Name="ShellNavigationView"
                Grid.Row="1"
                PaneDisplayMode="Auto"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="False"
                CompactModeThresholdWidth="641"
                ExpandedModeThresholdWidth="1440"
                OpenPaneLength="260"
                ItemInvoked="OnShellNavigationItemInvoked"
                DisplayModeChanged="OnShellNavigationDisplayModeChanged"
                PaneOpened="OnShellNavigationPaneToggled"
                PaneClosed="OnShellNavigationPaneToggled">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="DashboardNavButton" Tag="Dashboard">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="RepositoryNavButton" Tag="Repository">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="OnlineNavButton" Tag="Online">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="UpdatesNavButton" Tag="Updates">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="UpdatesNavInfoBadge" Visibility="Collapsed" />
                        </NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="ShortcutsNavButton" Tag="Shortcuts">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <!-- The count follows running downloads; the flyout lists every task. -->
                    <NavigationViewItem x:Name="NavTasksButton" Tag="Downloads" SelectsOnInvoked="False">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="NavTasksBadge" Visibility="Collapsed" />
                        </NavigationViewItem.InfoBadge>
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="NavTasksLabelTextBlock" />
                            <ProgressBar x:Name="NavTasksProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Visibility="Collapsed" />
                        </Grid>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="NavTasksFlyout" Placement="RightEdgeAlignedBottom"
                                    Opening="OnNavTasksFlyoutOpening" Closed="OnNavTasksFlyoutClosed">
                                <Grid Width="380" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NavTasksTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                        <Button x:Name="NavTasksClearButton" Grid.Column="1" Click="OnClearDownloadTasksClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="NavTasksAllButton" Grid.Column="2" Click="OnNavTasksAllClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="NavTasksPanel" Spacing="8" />
                                    </ScrollViewer>
                                </Grid>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="SettingsNavButton" Tag="Settings">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

            <!-- The navigation view draws the content layer (its rounded content area over Mica);
                 the page margins follow the window width (MainWindow.Shell.cs). -->
            <Grid x:Name="PagesHostGrid">
                <!-- Repository page. RepositoryWorkspace.cs fills the cards and places the workbench columns. -->
                <Grid x:Name="WorkspacePageHost" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Title and repository picker with refresh, import and launch; under them the view buttons and the counts. -->
                    <Border x:Name="RepositoryToolbarCard" Style="{StaticResource CommandSurfaceBorderStyle}" Padding="14,10,14,10" CornerRadius="6">
                        <Grid x:Name="RepositoryToolbarGrid" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="RepositoryHeaderGrid" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock x:Name="WorkspaceTitleTextBlock" Style="{StaticResource PageTitleTextStyle}" />
                                    <ComboBox x:Name="RepositoryWorkspacePicker" MinWidth="190" MaxWidth="300" MinHeight="32" HorizontalAlignment="Left"
                                            SelectionChanged="OnRepositoryWorkspacePickerSelectionChanged" />
                                </StackPanel>
                                <Grid x:Name="RepositoryToolbarCommandsGrid" Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RefreshButton" HorizontalAlignment="Left" MinHeight="36" Click="OnRefreshClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="ImportZipButton" Grid.Column="1" HorizontalAlignment="Left" MinHeight="36" Click="OnImportZipClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="RunLauncherButton" Grid.Column="2" HorizontalAlignment="Left" MinHeight="36" Click="OnRunLauncherClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- The view buttons, details and the import commands are added by RepositoryWorkspace.cs and ExistingModImport.cs.
                                     The buttons keep their width; the counts give way and trim when a language needs more room. -->
                                <StackPanel x:Name="RepositoryViewButtonsPanel" Orientation="Horizontal" Spacing="6" />
                                <TextBlock x:Name="RepositoryCountTextBlock" Grid.Column="1" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Hidden holders: the toolbar and footer take these controls, and the counts are read from the metrics. -->
                    <Grid x:Name="WorkspaceActionsGrid" ColumnSpacing="14" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <ProgressBar x:Name="CopyProgressBar" Minimum="0" Maximum="100" Height="8" />
                            <TextBlock x:Name="ProgressTextBlock" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="RepositoryMetricsGrid" Visibility="Collapsed" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" MinWidth="220" />
                            <ColumnDefinition Width="1.1*" MinWidth="220" />
                            <ColumnDefinition Width="1.15*" MinWidth="240" />
                            <ColumnDefinition Width="1.05*" MinWidth="220" />
                        </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="FirstCountLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="FirstCountTextBlock" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                        <TextBlock x:Name="FirstCountHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SecondCountLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="SecondCountTextBlock" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                        <TextBlock x:Name="SecondCountHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="CurrentStateLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="CurrentStateHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="CurrentFolderLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="CurrentFolderHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
                    <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Row="1"
                            VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid x:Name="WorkspaceContentGrid" RowSpacing="10" Margin="0,0,8,4" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="WorkspaceWorkbench" ColumnSpacing="12" RowSpacing="12">
                                <!-- Characters: heading with add and "More", search, the list, and a hint while the repository is empty. -->
                                <Border x:Name="CategoryCard" Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="RepositoryCategoryTitleTextBlock" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button x:Name="CreateFirstLevelButton" Grid.Column="1" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="5" CornerRadius="4"
                                                    Click="OnCreateFirstLevelClicked" Style="{StaticResource SecondaryButtonStyle}">
                                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                                            </Button>
                                            <!-- Rename, avatar and the several-Mods toggle are in the "More" menu, the same menu as a right-click on a
                                                 character. The hidden controls keep their state and handlers. -->
                                            <Button x:Name="CharacterMoreButton" Grid.Column="2" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="5" CornerRadius="4"
                                                    Click="OnCharacterMoreClicked" Style="{StaticResource SecondaryButtonStyle}">
                                                <FontIcon FontSize="16" Glyph="&#xE712;" />
                                            </Button>
                                            <Button x:Name="RenameFirstLevelButton" Grid.Column="2" Visibility="Collapsed" Click="OnRenameFirstLevelClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button x:Name="CharacterAvatarButton" Grid.Column="2" Visibility="Collapsed" Click="OnCharacterAvatarButtonClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                            <ToggleButton x:Name="CharacterMultipleModsToggle" Grid.Column="2" Visibility="Collapsed" Click="OnCharacterMultipleModsToggleClicked" />
                                        </Grid>
                                        <TextBox x:Name="FirstLevelSearchTextBox" Grid.Row="1" Height="34" MinWidth="0" Padding="8,6,8,6" BorderThickness="0"
                                                TextChanged="OnFirstLevelSearchTextChanged" />
                                        <ListView x:Name="FirstLevelListView" Grid.Row="2" MinHeight="0" SingleSelectionFollowsFocus="False" SelectionChanged="OnFirstLevelSelectionChanged" Style="{StaticResource AppListViewStyle}" ItemContainerStyle="{StaticResource CompactListViewItemStyle}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:FirstLevelFolderItem">
                                                    <Grid Padding="4,8" ColumnSpacing="8" RightTapped="OnFirstLevelItemRightTapped">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="28" Height="28">
                                                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind AvatarInitial}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" Visibility="{x:Bind AvatarPlaceholderVisibility, Mode=OneWay}" />
                                                            <Ellipse>
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{x:Bind AvatarImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" FontSize="12" Text="{x:Bind ChildrenCount}" VerticalAlignment="Center" Opacity="0.75" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="CharacterFolderHintTextBlock" Grid.Row="3" Margin="2,8,2,0" FontSize="12" Opacity="0.75"
                                                TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <!-- Mods: heading, search and tag buttons (added by LocalTags), state chips, and the list or cover views. -->
                                <Border x:Name="ModCard" Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid x:Name="ModCardGrid" RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="RepositoryModTitleTextBlock" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="RepositoryModCountTextBlock" Grid.Column="1" FontSize="12" VerticalAlignment="Center" />
                                            <Button x:Name="DeleteSecondLevelButton" Grid.Column="2" Width="32" Height="32" MinHeight="32" Padding="6" CornerRadius="4"
                                                    Click="OnDeleteSecondLevelClicked" Style="{StaticResource SecondaryButtonStyle}">
                                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                        <StackPanel x:Name="RepositoryStateChipsPanel" Grid.Row="2" Orientation="Horizontal" Spacing="6" />
                                        <Border x:Name="SecondLevelDropBorder" Grid.Row="3" Padding="0" AllowDrop="True" Style="{StaticResource InsetBorderStyle}"
                                                DragOver="OnSecondLevelDragOver" DragLeave="OnDropTargetDragLeave" Drop="OnSecondLevelDrop">
                                            <!-- The list; RepositoryWorkspace.cs adds the cover view and the empty state over it. -->
                                            <Grid x:Name="RepositoryModViewsGrid">
                                                <ListView x:Name="SecondLevelListView" MinHeight="0" SingleSelectionFollowsFocus="False" SelectionChanged="OnSecondLevelSelectionChanged" DoubleTapped="OnSecondLevelDoubleTapped" Style="{StaticResource AppListViewStyle}" ItemContainerStyle="{StaticResource AppListViewItemStyle}">
                                                    <ListView.ItemTemplate>
                                                        <!-- A row: cover thumbnail, name with its tag chips and shortcut count, size, and the state as a pill. -->
                                                        <DataTemplate x:DataType="local:SecondLevelFolderItem">
                                                            <Grid Padding="6,6" ColumnSpacing="10" RightTapped="OnSecondLevelItemRightTapped">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Width="40" Height="40" CornerRadius="6" Background="{ThemeResource AppPreviewBackgroundBrush}">
                                                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Opacity="0.6" Visibility="{x:Bind CoverPlaceholderVisibility, Mode=OneWay}" />
                                                                    <Image Source="{x:Bind CoverImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                                </Grid>
                                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                                    <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind DetailLineVisibility, Mode=OneWay}">
                                                                        <ItemsRepeater ItemsSource="{x:Bind Tags, Mode=OneWay}">
                                                                            <ItemsRepeater.Layout>
                                                                                <StackLayout Orientation="Horizontal" Spacing="4" />
                                                                            </ItemsRepeater.Layout>
                                                                            <ItemsRepeater.ItemTemplate>
                                                                                <DataTemplate x:DataType="x:String">
                                                                                    <Border Padding="6,0,6,1" CornerRadius="4" Background="{ThemeResource AppSecondaryDefaultBrush}">
                                                                                        <TextBlock FontSize="12" Opacity="0.85" Text="{x:Bind}" />
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsRepeater.ItemTemplate>
                                                                        </ItemsRepeater>
                                                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind KeysText, Mode=OneWay}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    MinWidth="64"
                                                                    Style="{StaticResource CaptionTextStyle}"
                                                                    Text="{x:Bind SizeText, Mode=OneWay}"
                                                                    TextAlignment="Right"
                                                                    VerticalAlignment="Center" />
                                                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                                                    <Border Style="{StaticResource StatusBadgeSuccessBorderStyle}" Visibility="{x:Bind DeployedPillVisibility, Mode=OneWay}">
                                                                        <TextBlock Style="{StaticResource StatusBadgeSuccessTextStyle}" Text="{x:Bind State, Mode=OneWay}" />
                                                                    </Border>
                                                                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Visibility="{x:Bind IdlePillVisibility, Mode=OneWay}">
                                                                        <TextBlock Style="{StaticResource StatusBadgeTextStyle}" Text="{x:Bind State, Mode=OneWay}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid x:Name="WorkspaceDetailHost" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="SelectionSummaryCard" Style="{StaticResource CardBorderStyle}" CornerRadius="6" Padding="12">
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock x:Name="SelectionEyebrowTextBlock" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock x:Name="CurrentFolderTextBlock" FontSize="18" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="DeploymentStateLabelTextBlock" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                                <TextBlock x:Name="CurrentStateTextBlock" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TabView x:Name="WorkspaceDetailTabs" Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" TabWidthMode="Equal"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectedIndex="0">
                                        <TabViewItem x:Name="PreviewTab" IsClosable="False">
                                            <Border x:Name="PreviewCard" Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Grid RowSpacing="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="PreviewSectionTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                                    <TextBlock x:Name="PreviewSectionSubtitleTextBlock" Grid.Row="1" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                                    <Border
                                                        x:Name="PreviewDropBorder"
                                                        Grid.Row="2"
                                                        Height="320"
                                                        AllowDrop="True"
                                                        Style="{StaticResource InsetBorderStyle}"
                                                        Background="{ThemeResource AppPreviewBackgroundBrush}"
                                                        DragOver="OnPreviewDragOver"
                                                        DragLeave="OnDropTargetDragLeave"
                                                        Drop="OnPreviewDrop">
                                                        <Grid>
                                                            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ImageOpened="OnPreviewImageOpened" Tapped="OnPreviewImageTapped" />
                                                            <TextBlock
                                                                x:Name="PreviewHintTextBlock"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="18"
                                                                TextAlignment="Center"
                                                                TextWrapping="Wrap"
                                                                Style="{StaticResource MutedTextStyle}" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Row="3" Spacing="6">
                                                        <TextBlock x:Name="ModLinkSectionTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                                        <TextBlock x:Name="ModLinkSectionSubtitleTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Border Grid.Row="4" Style="{StaticResource InsetBorderStyle}">
                                                        <TextBox
                                                            x:Name="ModLinkTextBox"
                                                            Padding="12,8"
                                                            BorderThickness="0"
                                                            TextChanged="OnModLinkTextChanged" />
                                                    </Border>

                                                    <Grid Grid.Row="5" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="PreviewFooterTextBlock" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                                        <Button
                                                            x:Name="OpenModLinkButton"
                                                            Grid.Column="1"
                                                            Click="OnOpenModLinkClicked"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </TabViewItem>
                                        <TabViewItem x:Name="ShortcutTab" IsClosable="False">
                                            <Border x:Name="ShortcutCard" Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Grid RowSpacing="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="ShortcutSectionTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock x:Name="ShortcutSectionSubtitleTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="ShortcutRowsTextBlock" Style="{StaticResource MutedTextStyle}" />
                                                        </StackPanel>
                                                        <Button x:Name="AddShortcutRowButton" Grid.Column="1" Click="OnAddShortcutRowClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel x:Name="ShortcutRowsPanel" Spacing="10" />
                                                    </ScrollViewer>
                                                    <TextBlock
                                                        x:Name="ShortcutHintTextBlock"
                                                        Grid.Row="3"
                                                        Margin="0,4,0,2"
                                                        Style="{StaticResource MutedTextStyle}"
                                                        TextWrapping="WrapWholeWords" />
                                                </Grid>
                                            </Border>
                                        </TabViewItem>
                                        <TabViewItem x:Name="PersistentSlotsTab" IsClosable="False">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                                <Border x:Name="PersistentSlotsCard" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock x:Name="PersistentSlotTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                                                        <TextBlock x:Name="PersistentSlotHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="PersistentUserIniTextBox" PlaceholderText="d3dx_user.ini" />
                                                            <Button x:Name="BrowsePersistentUserIniButton" Grid.Column="1" Click="OnBrowsePersistentUserIniClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                                        </Grid>
                                                        <ComboBox x:Name="PersistentSlotComboBox" SelectionChanged="OnPersistentSlotSelectionChanged" HorizontalAlignment="Stretch" />
                                                        <ContentControl x:Name="PersistentSlotPreviewHost" HorizontalContentAlignment="Stretch" />
                                                        <TextBlock x:Name="PersistentSlotValuesTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Name="CapturePersistentSlotButton" Click="OnCapturePersistentSlotClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                                                            <Button x:Name="DeletePersistentSlotButton" Grid.Column="1" Click="OnDeletePersistentSlotClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                                                        </Grid>
                                                        <Button x:Name="RestorePersistentRuntimeButton" Click="OnRestorePersistentRuntimeClicked" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButtonStyle}" />
                                                        <DropDownButton x:Name="PersistentSlotMoreButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                        <Button x:Name="OpenCombinationPresetsButton" Click="OnOpenCombinationPresetsClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" />
                                                        <TextBlock x:Name="PersistentSlotStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </ScrollViewer>
                                        </TabViewItem>
                                    </TabView>
                                    <Border x:Name="RepositoryDetailFooterCard" Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="6">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="RepositoryDeploymentHintTextBlock" FontSize="12" Opacity="0.8" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Grid Grid.Row="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="RepositoryOpenModFolderButton" MinWidth="44" MinHeight="40" CornerRadius="4"
                                                        Click="OnRepositoryOpenModFolderClicked" Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                                </Button>
                                                <Button x:Name="ToggleCopyButton" Grid.Column="1" MinHeight="40" HorizontalAlignment="Stretch" Click="OnToggleCopyClicked" Style="{StaticResource PrimaryButtonStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Border x:Name="WorkspaceStatusCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="AuthorTextBlock" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="OnlineScrollViewer" Visibility="Collapsed" Margin="6">
                    <!-- One card: header row, then character rail beside the results. Details open in a
                         drawer floating over the right side, so the page never shrinks while it is open. -->
                    <Grid x:Name="OnlineDetailsHost" SizeChanged="OnOnlineDetailsHostSizeChanged">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="16,12,16,12">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="OnlineTitleTextBlock" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
                                            <!-- The page descriptions live in this tooltip instead of two header lines. -->
                                            <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.7" VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="420">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock x:Name="OnlinePreviewTitleTextBlock" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="OnlinePreviewHintTextBlock" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="OnlineSubtitleTextBlock" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border
                                                Background="{ThemeResource AppAccentSoftBrush}"
                                                CornerRadius="6"
                                                Padding="10,4">
                                                <TextBlock
                                                    x:Name="OnlineStatusTextBlock"
                                                    MaxLines="1"
                                                    MaxWidth="460"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Border>
                                            <Border
                                                x:Name="OnlineCacheStatusBorder"
                                                Background="{ThemeResource AppInsetBackgroundBrush}"
                                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                Visibility="Collapsed">
                                                <TextBlock
                                                    x:Name="OnlineCacheStatusTextBlock"
                                                    MaxLines="1"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" x:Name="OnlineDownloadProgressPanel" Width="240" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="OnlineDownloadProgressTextBlock" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar x:Name="OnlineDownloadProgressBar" Minimum="0" Maximum="100" Height="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2" Padding="2" CornerRadius="8" Background="{ThemeResource AppInsetBackgroundBrush}">
                                                <Button
                                                    x:Name="OnlineListLayoutButton"
                                                    Width="36"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnOnlineListLayoutClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="15" Glyph="&#xEA37;" />
                                                </Button>
                                                <Button
                                                    x:Name="OnlineGridLayoutButton"
                                                    Width="36"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnOnlineGridLayoutClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="15" Glyph="&#xECA5;" />
                                                </Button>
                                            </StackPanel>
                                            <Button
                                                x:Name="RefreshOnlineButton"
                                                Click="OnRefreshOnlineModsClicked"
                                                MinHeight="36"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        x:Name="OnlineWorkspaceGrid"
                                        Grid.Row="1"
                                        HorizontalAlignment="Stretch"
                                        ColumnSpacing="12"
                                        RowSpacing="12"
                                        SizeChanged="OnOnlineWorkspaceGridSizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="OnlineCharacterRailColumn" Width="188" />
                                            <ColumnDefinition x:Name="OnlineResultsColumn" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition x:Name="OnlineCharacterRailRow" Height="*" />
                                            <RowDefinition x:Name="OnlineResultsRow" Height="0" />
                                        </Grid.RowDefinitions>

                                        <Border x:Name="OnlineCharacterRailHost" Grid.Column="0" Style="{StaticResource InsetBorderStyle}" Padding="10">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    x:Name="OnlineCharacterRailTitleTextBlock"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    TextAlignment="Left"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <ScrollViewer
                                                    x:Name="OnlineCharacterRailScrollViewer"
                                                    Grid.Row="1"
                                                    Padding="0,0,2,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    HorizontalScrollMode="Disabled"
                                                    VerticalContentAlignment="Stretch"
                                                    VerticalScrollBarVisibility="Auto"
                                                    VerticalScrollMode="Enabled">
                                                    <StackPanel
                                                        x:Name="OnlineCharacterAvatarPanel"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,0,10,0"
                                                        Orientation="Vertical"
                                                        Spacing="6" />
                                                </ScrollViewer>
                                                <TextBlock
                                                    x:Name="OnlineCharacterRailHintTextBlock"
                                                    Grid.Row="2"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                        </Border>

                                        <Grid
                                            x:Name="OnlineResultsHost"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            MinWidth="0"
                                            RowSpacing="8"
                                            SizeChanged="OnOnlineResultsHostSizeChanged">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- One toolbar row: search, sort, then the page filters and options. -->
                                            <Grid ColumnSpacing="8" Canvas.ZIndex="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="176" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="OnlineSearchTextBox"
                                                    MinHeight="36"
                                                    Padding="12,7"
                                                    TextChanged="OnOnlineSearchTextChanged" />
                                                <ComboBox
                                                    x:Name="OnlineCharacterComboBox"
                                                    Visibility="Collapsed"
                                                    MinHeight="36"
                                                    HorizontalAlignment="Stretch"
                                                    SelectionChanged="OnOnlineCharacterSelectionChanged" />
                                                <ComboBox
                                                    x:Name="OnlineSortComboBox"
                                                    Grid.Column="1"
                                                    MinHeight="36"
                                                    HorizontalAlignment="Stretch"
                                                    SelectionChanged="OnOnlineSortSelectionChanged" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                    <Button x:Name="OnlineWorkFilterButton" MinHeight="36" Padding="10,2" Click="OnOnlineWorkFilterClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button x:Name="ClearOnlineFiltersButton" MinHeight="36" Padding="10,2" Click="OnClearOnlineFiltersClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button x:Name="OnlineSavedItemsButton" Width="36" Height="36" Padding="0" Click="OnOnlineSavedItemsClicked" Style="{StaticResource SecondaryButtonStyle}"><FontIcon FontSize="14" Glyph="&#xE734;" /></Button>
                                                    <Button x:Name="OnlineDownloadOptionsButton" Width="36" Height="36" Padding="0" Click="OnOnlineDownloadOptionsClicked" Style="{StaticResource SecondaryButtonStyle}"><FontIcon FontSize="14" Glyph="&#xE713;" /></Button>
                                                </StackPanel>
                                            </Grid>
                                            <ListView
                                                x:Name="OnlineVirtualizedListView"
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                MinHeight="0"
                                                Canvas.ZIndex="0"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnOnlineResultItemClick"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.HorizontalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Enabled"
                                                SelectionMode="None">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Margin" Value="0,0,12,7" />
                                                        <Setter Property="Padding" Value="0" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl
                                                            HorizontalContentAlignment="Stretch"
                                                            Tag="OnlineListCardPresenter"
                                                            DataContextChanged="OnOnlineListCardPresenterDataContextChanged" />
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                                <ListView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsStackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </ListView.ItemsPanel>
                                            </ListView>
                                            <!-- Item size comes from OnlineLayoutPolicy.GridTiles; clicking a tile (or Enter) opens its details. -->
                                            <GridView
                                                x:Name="OnlineVirtualizedGridView"
                                                SizeChanged="OnOnlineGridSizeChanged"
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                MinHeight="0"
                                                Canvas.ZIndex="0"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnOnlineResultItemClick"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.HorizontalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Enabled"
                                                SelectionMode="None"
                                                Visibility="Collapsed">
                                                <GridView.ItemContainerStyle>
                                                    <Style TargetType="GridViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Padding" Value="0" />
                                                    </Style>
                                                </GridView.ItemContainerStyle>
                                                <GridView.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            IsTabStop="False"
                                                            Tag="OnlineGridCardPresenter"
                                                            DataContextChanged="OnOnlineGridCardPresenterDataContextChanged" />
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                                <GridView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid ItemWidth="300" ItemHeight="307" Orientation="Horizontal" Loaded="OnOnlineGridPanelLoaded" />
                                                    </ItemsPanelTemplate>
                                                </GridView.ItemsPanel>
                                            </GridView>
                                            <ContentControl
                                                x:Name="OnlineEmptyResultsContentControl"
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Top"
                                                Margin="0,0,12,0"
                                                Visibility="Collapsed" />
                                            <Border
                                                x:Name="OnlineLoadingOverlay"
                                                Grid.Row="1"
                                                Background="{ThemeResource AppCardBackgroundBrush}"
                                                CornerRadius="12"
                                                Visibility="Collapsed">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                                    <ProgressRing Width="36" Height="36" IsActive="True" />
                                                    <TextBlock x:Name="OnlineLoadingTextBlock" Style="{StaticResource MutedTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                                    <StackPanel Width="260" Spacing="8" Opacity="0.55">
                                                        <Border Height="10" CornerRadius="5" Background="{ThemeResource AppAccentSoftBrush}" />
                                                        <Border Height="10" Width="210" HorizontalAlignment="Left" CornerRadius="5" Background="{ThemeResource AppAccentSoftBrush}" />
                                                        <Border Height="10" Width="235" HorizontalAlignment="Left" CornerRadius="5" Background="{ThemeResource AppAccentSoftBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                        <Grid
                            x:Name="OnlineDetailDrawer"
                            Grid.Row="1"
                            Width="600"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Canvas.ZIndex="10">
                            <!-- A soft edge shadow separates the drawer from the cards underneath. -->
                            <Border Width="24" Margin="-24,12,0,12" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#38000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="OnlineDetailPaneBorder" Style="{StaticResource DetailPaneBorderStyle}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource InsetBorderStyle}" Padding="14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="OnlineDetailPaneTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="Wrap" />
                                                <!-- Step through the Mods shown on this page without closing the drawer. -->
                                                <Button
                                                    x:Name="OnlineDetailPreviousButton"
                                                    Grid.Column="1"
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    Click="OnOnlineDetailPreviousClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                                                </Button>
                                                <Button
                                                    x:Name="OnlineDetailNextButton"
                                                    Grid.Column="2"
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    Click="OnOnlineDetailNextClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                                                </Button>
                                                <Button
                                                    x:Name="CloseOnlineDetailButton"
                                                    Grid.Column="3"
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    Click="OnCloseOnlineDetailsClicked"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                                </Button>
                                            </Grid>

                                            <TextBlock x:Name="OnlineDetailPaneMetaTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="OnlineDetailPaneStatusTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,14,0" Spacing="12">
                                            <Border x:Name="OnlineDetailHeroBorder" Background="{ThemeResource AppPreviewBackgroundBrush}" CornerRadius="12" Height="360">
                                                <Grid>
                                                    <Image x:Name="OnlineDetailHeroImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed" ImageOpened="OnOnlineDetailHeroImageOpened" Tapped="OnOnlineDetailHeroImageTapped" />
                                                    <TextBlock
                                                        x:Name="OnlineDetailHeroPlaceholderTextBlock"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        Style="{StaticResource CaptionTextStyle}" />
                                                </Grid>
                                            </Border>

                                            <ScrollViewer x:Name="OnlineDetailThumbnailScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                                <StackPanel x:Name="OnlineDetailThumbnailPanel" Margin="0,0,0,12" Orientation="Horizontal" Spacing="8" />
                                            </ScrollViewer>

                                            <Border x:Name="OnlineDetailRequirementBorder" Style="{StaticResource InsetBorderStyle}" Visibility="Collapsed">
                                                <StackPanel Spacing="6">
                                                    <TextBlock x:Name="OnlineDetailRequirementTitleTextBlock" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="OnlineDetailRequirementTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock x:Name="OnlineDetailSummaryTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="OnlineDetailTranslationNoteTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                                            <TextBlock x:Name="OnlineDetailDescriptionTextBlock" TextWrapping="Wrap" />

                                            <Border Style="{StaticResource InsetBorderStyle}" Padding="12">
                                                <TextBlock x:Name="OnlineDetailDownloadHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Row="2" Style="{StaticResource StickyActionBorderStyle}">
                                        <StackPanel Spacing="9">
                                            <TextBlock
                                                x:Name="OnlineDetailDownloadSelectionTextBlock"
                                                Style="{StaticResource CaptionTextStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    x:Name="OpenOnlineDetailPageButton"
                                                    Click="OnOpenOnlineDetailPageClicked"
                                                    HorizontalAlignment="Stretch"
                                                    MinHeight="40"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button
                                                    x:Name="SelectOnlineDetailDownloadButton"
                                                    Grid.Column="1"
                                                    Click="OnSelectOnlineDetailDownloadClicked"
                                                    HorizontalAlignment="Stretch"
                                                    MinHeight="40"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>
                                            <Button
                                                x:Name="DownloadOnlineDetailButton"
                                                Click="OnDownloadOnlineDetailClicked"
                                                HorizontalAlignment="Stretch"
                                                MinHeight="42"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                                            <!-- Footer: what this page shows, then paging. -->
                                            <Grid Grid.Row="2" ColumnSpacing="8" Canvas.ZIndex="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="OnlineFilterSummaryTextBlock" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextStyle}" />
                                                <Button
                                                    x:Name="OnlinePrevPageButton"
                                                    Grid.Column="1"
                                                    Click="OnOnlinePrevPageClicked"
                                                    MinHeight="32"
                                                    MinWidth="84"
                                                    Padding="12,4"
                                                    HorizontalContentAlignment="Center"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBlock
                                                    x:Name="OnlinePaginationTextBlock"
                                                    Grid.Column="2"
                                                    Margin="6,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextStyle}" />
                                                <Button
                                                    x:Name="OnlineNextPageButton"
                                                    Grid.Column="3"
                                                    Click="OnOnlineNextPageClicked"
                                                    MinHeight="32"
                                                    MinWidth="84"
                                                    Padding="12,4"
                                                    HorizontalContentAlignment="Center"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                    </Grid>
                </Grid>

                <!-- The combination preset controls. They used to sit on the Updates page; the Mod workspace's
                     Presets view takes them at startup (MainWindow.RepositoryWorkspace.cs), so this holder
                     never shows. They move with the workspace in stage J7. -->
                <Grid x:Name="CombinationProfileControlsHost" Visibility="Collapsed">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="ConfigurationProfilesTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="ConfigurationProfilesHintTextBlock" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="ConfigurationProfileComboBox"
                                MinHeight="42"
                                SelectionChanged="OnConfigurationProfileSelectionChanged" />
                            <CheckBox x:Name="CaptureCombinationStateCheckBox" IsChecked="True" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CombinationUserIniTextBox" IsReadOnly="True" MinWidth="0" />
                                <Button x:Name="BrowseCombinationUserIniButton" Grid.Column="1" Click="OnBrowsePersistentUserIniClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CreateConfigurationProfileButton" Click="OnCreateConfigurationProfileClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Name="UpdateConfigurationProfileButton" Grid.Column="1" Click="OnUpdateConfigurationProfileClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Name="ApplyConfigurationProfileButton" Grid.Column="2" Click="OnApplyConfigurationProfileClicked" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button x:Name="DeleteConfigurationProfileButton" Grid.Column="4" Click="OnDeleteConfigurationProfileClicked" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <TextBlock x:Name="ConfigurationProfileSummaryTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- The page containers above are moved into wrapper pages at startup (MainWindow.Shell.cs);
                     this host shows the current one. -->
                <ContentControl x:Name="PageContentHost" IsTabStop="False"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
            </NavigationView>
        </Grid>
        <!-- Bottom centre, above the page footers: the corner held paging and Deploy buttons. -->
        <InfoBar
            x:Name="AppInfoBar"
            MaxWidth="520"
            Margin="24,0,24,72"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Window>
