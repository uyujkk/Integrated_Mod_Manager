<Window
    x:Class="ModFolderCopier.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ModFolderCopier.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Integrated Mod Manager v4.0.0"
    SizeChanged="OnWindowSizeChanged"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppPageBackgroundBrush}" KeyDown="OnRootKeyDown" PointerPressed="OnRootGridPointerPressed">
        <Grid x:Name="AppShellGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- WinUI #10374: setting TitleBar.IconSource on SDK 1.7 can leave the content at its
                 old size when the window is snapped. ApplyWindowIcon still sets the window icon. -->
            <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
                <!-- Below 1120 px the box becomes a search button, so the title bar keeps room (J8). -->
                <Grid>
                    <AutoSuggestBox x:Name="TitleBarSearchBox" MinWidth="200" MaxWidth="440" VerticalAlignment="Center"
                                    QueryIcon="Find" GotFocus="OnTitleBarSearchGotFocus" />
                    <Button x:Name="TitleBarSearchButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="40" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                            Click="OnTitleBarSearchButtonClicked">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                    </Button>
                </Grid>
            </TitleBar>

            <!-- Left navigation like Windows Settings: labelled from 1440 px wide (unless the user
                 collapsed it), icons below that. Item names are the old button names, so they keep
                 their automation ids. Downloads opens a flyout instead of a page. -->
            <NavigationView
                x:Name="ShellNavigationView"
                Grid.Row="1"
                PaneDisplayMode="Auto"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="False"
                CompactModeThresholdWidth="641"
                ExpandedModeThresholdWidth="1440"
                OpenPaneLength="260"
                ItemInvoked="OnShellNavigationItemInvoked"
                DisplayModeChanged="OnShellNavigationDisplayModeChanged"
                PaneOpened="OnShellNavigationPaneToggled"
                PaneClosed="OnShellNavigationPaneToggled">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="DashboardNavButton" Tag="Dashboard">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="RepositoryNavButton" Tag="Repository">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="OnlineNavButton" Tag="Online">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="UpdatesNavButton" Tag="Updates">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="UpdatesNavInfoBadge" Visibility="Collapsed" />
                        </NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="ShortcutsNavButton" Tag="Shortcuts">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <!-- The count follows running downloads; the flyout lists every task. -->
                    <NavigationViewItem x:Name="NavTasksButton" Tag="Downloads" SelectsOnInvoked="False">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="NavTasksBadge" Visibility="Collapsed" />
                        </NavigationViewItem.InfoBadge>
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="NavTasksLabelTextBlock" />
                            <ProgressBar x:Name="NavTasksProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Visibility="Collapsed" />
                        </Grid>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="NavTasksFlyout" Placement="RightEdgeAlignedBottom"
                                    Opening="OnNavTasksFlyoutOpening" Closed="OnNavTasksFlyoutClosed">
                                <Grid Width="380" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NavTasksTitleTextBlock" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                        <Button x:Name="NavTasksClearButton" Grid.Column="1" Click="OnClearDownloadTasksClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="NavTasksAllButton" Grid.Column="2" Click="OnNavTasksAllClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="NavTasksPanel" Spacing="8" />
                                    </ScrollViewer>
                                </Grid>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="SettingsNavButton" Tag="Settings">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

            <!-- The navigation view draws the content layer (its rounded content area over Mica);
                 the page margins follow the window width (MainWindow.Shell.cs). -->
            <Grid x:Name="PagesHostGrid">
                <!-- Repository page. RepositoryWorkspace.cs fills the cards and places the workbench columns. -->

                <!-- The page containers above are moved into wrapper pages at startup (MainWindow.Shell.cs);
                     this host shows the current one. -->
                <ContentControl x:Name="PageContentHost" IsTabStop="False"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
            </NavigationView>
        </Grid>
        <!-- Bottom centre, above the page footers: the corner held paging and Deploy buttons. -->
        <InfoBar
            x:Name="AppInfoBar"
            MaxWidth="520"
            Margin="24,0,24,72"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Window>
