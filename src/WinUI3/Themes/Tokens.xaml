<!--
    Design tokens (stage J1T, docs/development/UI-Fluent-Design-Plan.md). The App*Brush names the pages
    use stand for the Windows system brushes named in the comments: light and dark use those brushes'
    Fluent values, accents use the system accent colours, and high contrast uses the system colours, so
    colours follow the user's accent and high-contrast theme.

    The values are written out here instead of aliasing the system brushes (<StaticResource ResourceKey=...>)
    because an alias to another dictionary resolves in the app-wide theme, the Windows one: with Windows
    dark and the app set to light, every aliased colour came out dark. Each theme dictionary below is
    complete on its own, so XAML ({ThemeResource}) and code (MainWindow.GetAppThemeBrush) get the same,
    right value. Add colours here, never as fixed values in a page.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- AccentFillColorDefaultBrush: primary buttons. -->
            <SolidColorBrush x:Key="AppPrimaryButtonBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <!-- no system brush: the window root: transparent, so Mica shows. -->
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="Transparent" />
            <!-- LayerFillColorDefaultBrush: the layer the pages sit on. -->
            <SolidColorBrush x:Key="AppContentLayerBrush" Color="#80FFFFFF" />
            <!-- CardBackgroundFillColorDefaultBrush: cards. -->
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#B3FFFFFF" />
            <!-- SolidBackgroundFillColorTertiaryBrush: opaque surfaces over other content: drawer, palette. -->
            <SolidColorBrush x:Key="AppElevatedBackgroundBrush" Color="#F9F9F9" />
            <!-- CardStrokeColorDefaultBrush: card edges. -->
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#0F000000" />
            <!-- SurfaceStrokeColorDefaultBrush: edges of raised surfaces. -->
            <SolidColorBrush x:Key="AppStrongBorderBrush" Color="#66757575" />
            <!-- CardBackgroundFillColorSecondaryBrush: recessed areas inside cards. -->
            <SolidColorBrush x:Key="AppInsetBackgroundBrush" Color="#80F6F6F6" />
            <!-- no system brush: the navigation: on Mica. -->
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="Transparent" />
            <!-- CardBackgroundFillColorDefaultBrush: toolbars. -->
            <SolidColorBrush x:Key="AppCommandSurfaceBrush" Color="#B3FFFFFF" />
            <!-- AccentFillColorDefaultBrush: accent marks and badges. -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <!-- SystemFillColorAttentionBackgroundBrush: quiet highlighted backgrounds. -->
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#80F6F6F6" />
            <!-- SubtleFillColorSecondaryBrush: selected navigation item. -->
            <SolidColorBrush x:Key="AppNavSelectedBrush" Color="#09000000" />
            <!-- SubtleFillColorTransparentBrush: navigation item at rest. -->
            <SolidColorBrush x:Key="AppNavDefaultBrush" Color="#00FFFFFF" />
            <!-- SubtleFillColorSecondaryBrush: navigation item under the pointer. -->
            <SolidColorBrush x:Key="AppNavHoverBrush" Color="#09000000" />
            <!-- TextFillColorPrimaryBrush. -->
            <SolidColorBrush x:Key="AppNavSelectedForegroundBrush" Color="#E4000000" />
            <!-- TextFillColorPrimaryBrush. -->
            <SolidColorBrush x:Key="AppNavDefaultForegroundBrush" Color="#E4000000" />
            <!-- AccentFillColorDefaultBrush: the accent outline of a selected item. -->
            <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <!-- TextFillColorDisabledBrush. -->
            <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="#5C000000" />
            <!-- ControlFillColorDefaultBrush: chips and toggles at rest. -->
            <SolidColorBrush x:Key="AppSecondaryDefaultBrush" Color="#B3FFFFFF" />
            <!-- TextFillColorPrimaryBrush. -->
            <SolidColorBrush x:Key="AppSecondaryDefaultForegroundBrush" Color="#E4000000" />
            <!-- SubtleFillColorSecondaryBrush: chips and toggles when selected, with the accent outline. -->
            <SolidColorBrush x:Key="AppSecondarySelectedBrush" Color="#09000000" />
            <!-- TextFillColorPrimaryBrush. -->
            <SolidColorBrush x:Key="AppSecondarySelectedForegroundBrush" Color="#E4000000" />
            <!-- CardBackgroundFillColorSecondaryBrush: image placeholders. -->
            <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="#80F6F6F6" />
            <!-- SystemFillColorSuccessBackgroundBrush. -->
            <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#DFF6DD" />
            <!-- SystemFillColorSuccessBrush. -->
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#0F7B0F" />
            <!-- SystemFillColorCriticalBackgroundBrush. -->
            <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FDE7E9" />
            <!-- SystemFillColorCriticalBrush. -->
            <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C" />
            <!-- SmokeFillColorDefaultBrush: the dimmed window behind the command palette. -->
            <SolidColorBrush x:Key="AppSmokeBrush" Color="#4D000000" />
            <!-- AcrylicInAppFillColorDefaultBrush: the command palette. -->
            <AcrylicBrush x:Key="AppPaletteBackgroundBrush" TintColor="#FCFCFC" TintOpacity="0" TintLuminosityOpacity="0.85" FallbackColor="#F9F9F9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppPrimaryButtonBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AppContentLayerBrush" Color="#4C3A3A3A" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="AppElevatedBackgroundBrush" Color="#282828" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#19000000" />
            <SolidColorBrush x:Key="AppStrongBorderBrush" Color="#66757575" />
            <SolidColorBrush x:Key="AppInsetBackgroundBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AppCommandSurfaceBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="AppNavSelectedBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppNavDefaultBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppNavHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppNavSelectedForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppNavDefaultForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="#5DFFFFFF" />
            <SolidColorBrush x:Key="AppSecondaryDefaultBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppSecondaryDefaultForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSecondarySelectedBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppSecondarySelectedForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#393D1B" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#442726" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="AppSmokeBrush" Color="#4D000000" />
            <AcrylicBrush x:Key="AppPaletteBackgroundBrush" TintColor="#2C2C2C" TintOpacity="0.15" TintLuminosityOpacity="0.96" FallbackColor="#2C2C2C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppPrimaryButtonBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppContentLayerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppElevatedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppStrongBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppInsetBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppCommandSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppNavSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppNavDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AppNavHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppNavSelectedForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AppNavDefaultForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AppSecondaryDefaultBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AppSecondaryDefaultForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AppSecondarySelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppSecondarySelectedForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppDangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppSmokeBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="AppPaletteBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
