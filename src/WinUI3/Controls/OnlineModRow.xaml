<UserControl
    x:Class="ModFolderCopier.WinUI.OnlineModRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModFolderCopier.WinUI"
    HorizontalAlignment="Stretch">

    <!-- The list view's row: the grid tile's content and styling laid out horizontally. -->
    <Border
        x:Name="CardBorder"
        Padding="10"
        CornerRadius="12"
        BorderThickness="1"
        BorderBrush="{ThemeResource AppCardBorderBrush}"
        Background="{ThemeResource AppInsetBackgroundBrush}">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Height="99" CornerRadius="8" Background="{ThemeResource AppPreviewBackgroundBrush}">
                <Image x:Name="PreviewImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.PreviewPlaceholder, Mode=OneWay}"
                    Visibility="{x:Bind local:OnlineModTile.CollapsedWhen(ViewModel.HasPreview)}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}" />
                <ContentControl x:Name="InstalledHost" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False" />
                <Border
                    Margin="6"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    CornerRadius="6"
                    Background="#C0141C28"
                    ToolTipService.ToolTip="{x:Bind ViewModel.HotnessToolTip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{x:Bind ViewModel.HeatLabel, Mode=OneWay}" FontSize="10" Foreground="#D2FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.HotnessText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind ViewModel.Title}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Title}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.CharacterLabel, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Grid.Column="1" Text="·" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                    <ContentControl x:Name="AuthorHost" Grid.Column="2" HorizontalContentAlignment="Left" VerticalAlignment="Center" IsTabStop="False" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center"
                        Opacity="0.85"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatsToolTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xEB51;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.LikesText, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE890;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.ViewsText, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.DownloadsText, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusToolTip, Mode=OneWay}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button
                    Width="34"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.OpenPageCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.OpenPageToolTip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.OpenPageToolTip, Mode=OneWay}"
                    Style="{StaticResource SecondaryButtonStyle}">
                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                </Button>
                <Button
                    Width="34"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.DownloadCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.DownloadToolTip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.DownloadToolTip, Mode=OneWay}"
                    Style="{StaticResource SecondaryButtonStyle}">
                    <FontIcon Glyph="{x:Bind ViewModel.DownloadGlyph, Mode=OneWay}" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
