<UserControl
    x:Class="ModFolderCopier.WinUI.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">

    <!-- Icon, title and description on the left; the setting's own control on the right. -->
    <Border Style="{StaticResource SettingRowBorderStyle}">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <!-- One line keeps rows short enough for the overview to fit a windowed page; the tooltip has the rest. -->
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" MaxLines="2" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}" />
            </StackPanel>
            <ContentPresenter Grid.Column="2" Content="{x:Bind Action, Mode=OneWay}" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
