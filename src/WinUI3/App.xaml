<Application
    x:Class="ModFolderCopier.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <!-- After the system resources, so the tokens can point at their brushes. -->
                <ResourceDictionary Source="Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Corners follow the Windows geometry: OverlayCornerRadius (8) for cards and other containers,
                 ControlCornerRadius (4) for controls and areas inside a card. -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- The navigation sits on Mica, like the navigation of Windows Settings. -->
            <Style x:Key="NavigationPaneBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSidebarBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="8,12" />
            </Style>

            <Style x:Key="CommandSurfaceBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCommandSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <Style x:Key="SelectionSummaryBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,13" />
            </Style>

            <Style x:Key="ToolbarBadgeBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppInsetBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="9,5" />
            </Style>

            <Style x:Key="PageHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <!-- Opaque, because it floats over other content. -->
            <Style x:Key="DetailPaneBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource AppElevatedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppStrongBorderBrush}" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="StickyActionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppElevatedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,0" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="InsetBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppInsetBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="SettingRowBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppInsetBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <Style x:Key="SoftBadgeBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppAccentSoftBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- One status pill everywhere (ready, needs setup, deployed, idle): a neutral, success or danger tint. -->
            <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSecondaryDefaultBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="8,2" />
            </Style>
            <Style x:Key="StatusBadgeSuccessBorderStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource AppSuccessSoftBrush}" />
            </Style>
            <Style x:Key="StatusBadgeDangerBorderStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource AppDangerSoftBrush}" />
            </Style>
            <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="StatusBadgeSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AppSuccessBrush}" />
            </Style>
            <Style x:Key="StatusBadgeDangerTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AppDangerBrush}" />
            </Style>

            <!-- Sizes from the Windows type ramp (Caption 12, Body 14, Subtitle 20, Title 28). They are
                 not based on the system TextBlock styles, which turn on wrapping and would change layouts.
                 Secondary text uses the secondary text colour instead of opacity, which reads poorly on Mica. -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Buttons keep the Windows heights and padding; the accent comes from the system. -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="NavigationIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="64" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AppDangerBrush}" />
                <Setter Property="Background" Value="{ThemeResource AppDangerSoftBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppDangerBrush}" />
            </Style>

            <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="AppListViewStyle" TargetType="ListView">
                <Setter Property="Padding" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="IsItemClickEnabled" Value="False" />
            </Style>

            <Style x:Key="AppListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <!-- Narrow side lists (the workspace's characters): less item padding, so names keep more room. -->
            <Style x:Key="CompactListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource AppListViewItemStyle}">
                <Setter Property="Padding" Value="6,0,6,0" />
            </Style>

            <Style x:Key="ShortcutInputTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

