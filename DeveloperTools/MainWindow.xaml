<Window
    x:Class="IntegratedModManager.DeveloperTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="IMM Developer Tools"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ToolPageBrush}" Padding="14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ToolCardStyle}" Padding="18,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Width="38" Height="38" Source="Assets/AppIcon.png" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleTextBlock" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderSubtitleTextBlock" Style="{StaticResource ToolMutedTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{ThemeResource ToolAccentSoftBrush}" CornerRadius="5" Padding="9,4">
                        <TextBlock Text="Standalone · v3.9.4" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="ThemeButton" Click="OnThemeClicked" MinWidth="88" />
                    <Button x:Name="LanguageButton" Click="OnLanguageClicked" MinWidth="88" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolCardStyle}" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                <TextBox x:Name="RootPathTextBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" />
                <Button x:Name="BrowseRootButton" Grid.Column="2" Click="OnBrowseRootClicked" />
                <Button x:Name="RefreshAllButton" Grid.Column="3" Click="OnRefreshAllClicked" Style="{ThemeResource AccentButtonStyle}" />
                <ToggleSwitch x:Name="AutoRefreshToggle" Grid.Column="4" Toggled="OnAutoRefreshToggled" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabView x:Name="MainTabView" Grid.Row="2" IsAddTabButtonVisible="False">
            <TabViewItem x:Name="OverviewTab" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE80F;" />
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="2,8,2,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="VersionCardLabel" Style="{StaticResource ToolMutedTextStyle}" />
                                    <TextBlock x:Name="VersionCardValue" FontSize="23" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="RepositoryCardLabel" Style="{StaticResource ToolMutedTextStyle}" />
                                    <TextBlock x:Name="RepositoryCardValue" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="StorageCardLabel" Style="{StaticResource ToolMutedTextStyle}" />
                                    <TextBlock x:Name="StorageCardValue" FontSize="23" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="HealthCardLabel" Style="{StaticResource ToolMutedTextStyle}" />
                                    <TextBlock x:Name="HealthCardValue" FontSize="23" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="RuntimeTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                                    <TextBox x:Name="RuntimeTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="250" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="StorageTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                                    <StackPanel x:Name="StorageBreakdownPanel" Spacing="8" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="RepositoriesTab" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE8B7;" />
                </TabViewItem.IconSource>
                <Grid RowSpacing="12" Padding="2,8,2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ToolCardStyle}" Padding="14,10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RepositorySelectorLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="RepositoryComboBox" Grid.Column="1" SelectionChanged="OnRepositorySelectionChanged" />
                            <Button x:Name="ValidateRepositoryButton" Grid.Column="2" Click="OnValidateRepositoryClicked" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="OpenRepositoryButton" Grid.Column="3" Click="OnOpenRepositoryClicked" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ToolCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="PathInspectionTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                                <StackPanel x:Name="RepositoryPathPanel" Spacing="8" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="RepositoryReportTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                                <TextBox x:Name="RepositoryReportTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="FilesTab" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE8A5;" />
                </TabViewItem.IconSource>
                <Grid ColumnSpacing="12" Padding="2,8,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ToolCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ArtifactsTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                            <ListView x:Name="ArtifactListView" Grid.Row="1" SelectionChanged="OnArtifactSelectionChanged" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FileSearchTextBox" PlaceholderText="Search" TextChanged="OnFileSearchChanged" />
                                <Button x:Name="ValidateJsonButton" Grid.Column="1" Click="OnValidateJsonClicked" />
                                <Button x:Name="CopyViewerButton" Grid.Column="2" Click="OnCopyViewerClicked" />
                                <Button x:Name="SaveViewerButton" Grid.Column="3" Click="OnSaveViewerClicked" />
                            </Grid>
                            <TextBox x:Name="FileViewerTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" />
                            <TextBlock x:Name="FileViewerStatusTextBlock" Grid.Row="2" Style="{StaticResource ToolMutedTextStyle}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="DiagnosticsTab" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE9D5;" />
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="2,8,2,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="DiagnosticExportTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                                    <TextBlock x:Name="DiagnosticExportHintTextBlock" Style="{StaticResource ToolMutedTextStyle}" TextWrapping="Wrap" />
                                    <Button x:Name="ExportDiagnosticButton" Click="OnExportDiagnosticClicked" Style="{ThemeResource AccentButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="SnapshotTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                                    <TextBlock x:Name="SnapshotHintTextBlock" Style="{StaticResource ToolMutedTextStyle}" TextWrapping="Wrap" />
                                    <Button x:Name="CreateSnapshotButton" Click="OnCreateSnapshotClicked" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource ToolCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="FoldersTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                                    <TextBlock x:Name="FoldersHintTextBlock" Style="{StaticResource ToolMutedTextStyle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="OpenDiagnosticsButton" Click="OnOpenDiagnosticsClicked" />
                                        <Button x:Name="OpenSnapshotsButton" Click="OnOpenSnapshotsClicked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource ToolCardStyle}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DiagnosticResultTitleTextBlock" Style="{StaticResource ToolSectionTitleStyle}" />
                                <TextBox x:Name="DiagnosticResultTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="220" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />
    </Grid>
</Window>
